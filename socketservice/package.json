{
  "name": "@sponsorx/socketservice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SponsorX's live socket service (2S4-BE-18): its own Railway service, no database, no Clerk. Deal Chat now, the INFINEX game later.",
  "scripts": {
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "socket.io": "4.8.4",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
