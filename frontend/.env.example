# SponsorX frontend (Next.js) — copy to frontend/.env.local (Next auto-loads it).
# The backend's own variables live in the repo-root .env (see ../.env.example).

APP_ENV=staging

# Database — the frontend's server code (src/server) still talks to Postgres
# directly in Phase 1. Same value as the root .env.
DATABASE_URL=postgresql://sponsorx:sponsorx@localhost:5432/sponsorx

# Clerk (authentication — identity only). Keys from the Clerk dashboard.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Where the browser/server reaches the Express API service.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
