# SponsorX frontend (Next.js) — copy to frontend/.env.local (Next auto-loads it).
# The backend's own variables live in the repo-root .env (see ../.env.example).
#
# Corrected 2026-10-02 (P8-PMO-05): this file used to list DATABASE_URL and
# NEXT_PUBLIC_API_BASE_URL. Neither is read. Since the repo split the web app
# has no database at all — it reaches everything through the API — and the API
# address it reads is API_URL, server-side only. `grep -rhoE
# "process\.env\.[A-Z_]+" frontend/src` is the authority on this list.

# Clerk (authentication — identity only). The DEVELOPMENT instance's keys,
# from the Clerk dashboard → API keys (pk_test_… / sk_test_…). Read by
# @clerk/nextjs itself, so they never appear in the app's own code.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the web app's server code reaches the Express API (`npm run dev:api`).
# Server-side only — the browser never calls the API directly. This is also
# the default when unset.
API_URL=http://localhost:4000

# OPTIONAL. Shared secret that lets the API trust the visitor address the web
# app forwards (rate limits per visitor rather than per web server). Must match
# the API's own SPONSORX_EDGE_KEY. Unset locally is fine: limits then key on
# the connecting address.
# SPONSORX_EDGE_KEY=

# OPTIONAL. The contact address printed on /next/schools. Defaults to a
# placeholder (next@sponsorx.net) — set BTG's real mailbox before launch.
# NEXT_CONTACT_EMAIL=
