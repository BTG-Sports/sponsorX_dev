{
  "name": "sponsorx",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sponsorx/frontend",
    "dev:api": "npm run dev -w @sponsorx/backend",
    "dev:worker": "npm run worker -w @sponsorx/backend",
    "build": "npm run build -w @sponsorx/backend && npm run build -w @sponsorx/frontend",
    "test": "npm run test -w @sponsorx/backend && npm run test -w @sponsorx/frontend",
    "lint": "npm run lint -w @sponsorx/backend && npm run lint -w @sponsorx/frontend",
    "prisma:generate": "npm run prisma:generate -w @sponsorx/backend",
    "prisma:migrate": "npm run prisma:migrate -w @sponsorx/backend",
    "prisma:deploy": "npm run prisma:deploy -w @sponsorx/backend",
    "infra:up": "docker compose up -d postgres redis minio minio-setup",
    "infra:down": "docker compose down",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "db:test": "node scripts/setup-test-db.mjs",
    "deploy": "node scripts/deploy.mjs",
    "audit:check": "node scripts/audit-check.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "test:security-scripts": "node --test scripts/security-scripts.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
