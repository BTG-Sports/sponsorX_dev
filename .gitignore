# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm workspaces — one hoisted store at root, plus per-workspace)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production / build output
build/
frontend/.next/
backend/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers/

# Task board spreadsheets live in Google Drive, never in the repo
# (they go stale against the Sheet and cannot be diffed)
documentation/*.xlsx
documentation/*.xls

# Prisma 7 generated client — one schema (backend/prisma), one output. The
# frontend's copy was removed on 2026-09-21 with the generator that made it.
# Generated, never committed (Guide §02).
backend/src/generated/prisma

# Playwright (P2-QA-01)
playwright-report/
test-results/

# Landing 3D source kit (P1-ART-09): the Unity package is 829 MB and licensed
# per seat — it stays on each machine. The converted GLBs under
# frontend/public/models/city are what the site ships and what is committed.
Landing Page 3D Objects/*.unitypackage
