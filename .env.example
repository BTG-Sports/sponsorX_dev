# SponsorX — local environment template.
#
# Copy to `.env` at the repo root for the backend, and to `frontend/.env.local`
# for the web app. The defaults below match docker-compose.yml, so with the
# stack up (`npm run docker:up`) these values work as-is. Never commit real
# secrets — .env* is gitignored.

# ── Shared: database ─────────────────────────────────────────────────────────
# From the host (apps running via npm) use localhost. Inside Docker the compose
# file overrides this to postgresql://sponsorx:sponsorx@postgres:5432/sponsorx.
DATABASE_URL=postgresql://sponsorx:sponsorx@localhost:5432/sponsorx

# ── Backend: API service ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Cache / rate limiting (NOT the job queue — that is Postgres via pg-boss).
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, Cloudflare R2 in staging/production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sponsorx
S3_SECRET_ACCESS_KEY=sponsorx-dev-secret
S3_BUCKET_PUBLIC=sponsorx-public
S3_BUCKET_PRIVATE=sponsorx-private

# GeoLite2 City database, for the click-geo worker job (P6-BE-05).
#
# OPTIONAL. The file is a licensed MaxMind download and is deliberately not in
# the repository, so leaving this unset is a supported state: the worker starts
# normally, says so in its log, and records clicks with no location. Set it and
# clicks gain a city and a region.
#
# To obtain one: create a free MaxMind account, generate a licence key, and
# download GeoLite2-City.mmdb. Point this at the file.
# GEOLITE2_CITY_PATH=/path/to/GeoLite2-City.mmdb

# ── Frontend (put these in frontend/.env.local) ──────────────────────────────
# Clerk authentication — identity only. Get keys from the Clerk dashboard.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Where the browser/server reaches the API service.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
