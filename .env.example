# SponsorX — local environment template.
#
# Copy to `.env` at the repo root for the backend, and to `frontend/.env.local`
# for the web app. The defaults below match docker-compose.yml, so with the
# stack up (`npm run docker:up`) these values work as-is. Never commit real
# secrets — .env* is gitignored.

# ── Shared: database ─────────────────────────────────────────────────────────
# From the host (apps running via npm) use localhost. Inside Docker the compose
# file overrides this to postgresql://sponsorx:sponsorx@postgres:5432/sponsorx.
DATABASE_URL=postgresql://sponsorx:sponsorx@localhost:5432/sponsorx

# ── Backend: API service ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Cache / rate limiting (NOT the job queue — that is Postgres via pg-boss).
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, Cloudflare R2 in staging/production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sponsorx
S3_SECRET_ACCESS_KEY=sponsorx-dev-secret
S3_BUCKET_PUBLIC=sponsorx-public
S3_BUCKET_PRIVATE=sponsorx-private

# GeoLite2 City database, for the click-geo worker job (P6-BE-05).
#
# OPTIONAL. The file is a licensed MaxMind download and is deliberately not in
# the repository, so leaving this unset is a supported state: the worker starts
# normally, says so in its log, and records clicks with no location. Set it and
# clicks gain a city and a region.
#
# To obtain one: create a free MaxMind account, generate a licence key, and
# download GeoLite2-City.mmdb. Point this at the file.
# GEOLITE2_CITY_PATH=/path/to/GeoLite2-City.mmdb

# ── Zoho CRM sync (P8-INT-01..07) ────────────────────────────────────────────
# OPTIONAL. Without these every Zoho job waits in the queue and retries; the
# rest of the worker runs normally. Use the SponsorX-Dev SANDBOX token for
# anything that is not production, and pin the org so a production token
# pasted here by mistake is refused on its first call:
#   sandbox org id 7554807000000020005 · production org id 749122837
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_EXPECTED_ORG_ID=7554807000000020005
# Inbound: the Notifications API channel. The worker keeps it subscribed when
# all three are set; the webhook refuses every callback when they are not.
# ZOHO_NOTIFY_URL=https://<api public domain>/api/v1/webhooks/zoho/crm
# ZOHO_NOTIFY_TOKEN=            # 16+ random characters
# ZOHO_NOTIFY_CHANNEL_ID=       # digits only
# The Zoho Books invoice webhook's shared secret (P7-BE-04). Required in production.
# ZOHO_WEBHOOK_SECRET=

# ── Payments: Stripe (2S5-INT-01 / -03) ──────────────────────────────────────
# PAYMENT_PROVIDER=stripe needs the secret key and the platform webhook secret,
# or the API refuses to boot. A live key (sk_live_) is refused unless
# RAILWAY_ENVIRONMENT_NAME is exactly "production"; a test key is refused in
# production. Unset provider: "none" in production, "standin" elsewhere.
# documentation/SponsorX-Stripe-Integration.md has the endpoints and events.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=            # sk_test_… from the sandbox — never commit it
# STRIPE_WEBHOOK_SECRET=        # platform snapshot endpoint (whsec_…)
# STRIPE_THIN_WEBHOOK_SECRET=   # thin-event destination: payees' Accounts v2 changes
# STRIPE_CONNECT_WEBHOOK_SECRET= # Connect snapshot endpoint (optional)
# STRIPE_PUBLISHABLE_KEY=       # not needed by hosted Checkout
# STRIPE_CONNECT_COUNTRY=US

# ── Secret rotation overlap (2S8-SEC-02) ─────────────────────────────────────
# Set only DURING a rotation: the old value, still accepted (never used to
# sign) until deleted. Comma list allowed.
# documentation/SponsorX-Secrets-Rotation.md has the steps for each.
# ZOHO_WEBHOOK_SECRET_PREVIOUS=
# ZOHO_NOTIFY_TOKEN_PREVIOUS=
# INTAKE_TOKEN_SECRET_PREVIOUS=
# SPONSORX_EDGE_KEY_PREVIOUS=
# STANDIN_PROVIDER_SECRET_PREVIOUS=
# STRIPE_WEBHOOK_SECRET_PREVIOUS=
# STRIPE_THIN_WEBHOOK_SECRET_PREVIOUS=
# STRIPE_CONNECT_WEBHOOK_SECRET_PREVIOUS=

# ── Clerk allowed origins (2S8-PMO-02) ───────────────────────────────────────
# OPTIONAL. The web origins whose Clerk sessions the API accepts (the token's
# `azp`), comma-separated. Unset: APP_URL's origin plus http://127.0.0.1:3100,
# http://localhost:3100 and http://localhost:3000 outside production. If you
# set it, keep http://127.0.0.1:3100 in it or the e2e harness can't sign in.
# Set the same value on the web app.
# CLERK_AUTHORIZED_PARTIES=

# ── Frontend (put these in frontend/.env.local) ──────────────────────────────
# Clerk authentication — identity only. Get keys from the Clerk dashboard.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Where the browser/server reaches the API service.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
