// SponsorX — Prisma schema (P2-BE-02)
//
// Source: Implementation Guide V2 §03, reconciled against the eight §21 state
// machines in documentation/diagrams/state-machines/ and the pricing decision
// in documentation/SponsorX-Pricing-Floor-Decision.md (P0-PMO-13).
//
// FOUR CONVENTIONS, applied without exception:
//
//   1. `tenantId` on every model except Tenant itself. It is a plain column,
//      not a relation, exactly as §03 has it — enforcement is the job of the
//      scope functions (§04) and the authorization matrix (§09), and 25 foreign
//      keys back to one table buys nothing that a discipline plus a test does
//      not. WebhookDelivery.tenantId is the one nullable case: an inbound Zoho
//      webhook is recorded before it is known which tenant it belongs to, and
//      recording it anyway is the point of the model.
//
//   2. State enums lifted verbatim from §21. Every value in the eight .mmd
//      files appears below and nothing else does.
//
//   3. External IDs plus `lastSyncOrigin` and `lastSyncHash` on every model
//      Zoho touches — §18 makes Accounts, Contacts, Deals and Tasks
//      bi-directional, so that is Sponsor, Athlete, Property and Campaign.
//      §03 gave markers to only two of the four; the other two are corrected
//      here.
//
//   4. Events are rows, never counters. RewardEvent, LinkEvent and MetricDaily
//      each store one row per occurrence so the four-event fan funnel (§16)
//      stays separable after the fact.
//
// MONEY IS INTEGER CENTS throughout. No floats, anywhere, ever.
//
// ONE CORRECTION TO §03: the guide gives Athlete both `state String?` (the US
// state) and `state_ AthleteState @map("state")` (the lifecycle). Those collide
// on the same column and the schema will not compile. Geography is `stateCode`
// here — on Athlete, Property and CampaignBrief alike — and `state` means the
// lifecycle enum on every model without exception.
//
// WHAT IS DELIBERATELY NOT HERE: the three partial indexes Prisma cannot
// express — single-use reward redemption, the outbox drain and the one-open-
// invite rule. They are `P2-BE-03` and live in prisma/sql/, applied by their
// own migration. Adding them here would mean writing raw SQL into a file that
// is supposed to be the model.

generator client {
  provider = "prisma-client"

  // Explicit output path (Guide §02). Gitignored — generated, never committed.
  // Relative to this schema (backend/prisma/) → backend/src/generated/prisma.
  output = "../src/generated/prisma"
}

// REMOVED 2026-09-21 — there was a second generator here emitting a client into
// frontend/src/generated/prisma. It existed because, at the split, the frontend
// still queried Postgres directly.
//
// It does not any more: authorisation and every database read moved to this
// workspace (Addendum B), and the frontend reaches them over /api/v1. A second
// generated client would be a second way into the database from a workspace
// that must not have one — precisely the hazard that move removed — so the
// generator is gone rather than merely unused.

// Prisma 7: `url` is NOT permitted here any more. The connection string for
// Migrate lives in prisma.config.ts, and PrismaClient itself is constructed
// with an adapter. See https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — §21 state machines, verbatim
// ─────────────────────────────────────────────────────────────────────────────

/// Authorization lives here and in user_roles, never in Clerk (§04, Addendum A4).
enum Role {
  SUPER_ADMIN
  BTG_ADMIN
  SALES
  CAMPAIGN_MGR
  NETWORK_MGR
  FINANCE
  ATHLETE
  GUARDIAN
  PROPERTY_MGR
  SPONSOR_ADMIN
  SPONSOR_ANALYST
  SERVICE
}

enum AthleteState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ACTIVE
  SUSPENDED
}

enum BriefState {
  DRAFT
  QUALIFIED
  APPROVED
  CAMPAIGN_CREATED
  CLOSED
}

enum InviteState {
  INVITED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum CampaignState {
  DRAFT
  STAFFING
  APPROVAL
  ACTIVE
  REPORTING
  COMPLETED
  CANCELLED
}

enum OrderState {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliverableState {
  NOT_STARTED
  DRAFT_SUBMITTED
  BTG_REVIEW
  SPONSOR_REVIEW
  APPROVED
  PUBLISHED
  VERIFIED
}

enum EarningState {
  PENDING
  ELIGIBLE
  APPROVED_FOR_PAYOUT
  PAID
  HELD
  DISPUTED
}

enum RewardState {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

/// Four distinct events across the fan journey (§16). Never one counter.
enum RewardEventType {
  SCAN
  LANDING
  CLAIM
  REDEEM
}

/// The provenance taxonomy (P0-DATA-01). Every displayed number carries one.
enum MetricSource {
  VERIFIED_API
  VERIFIED_MANUAL
  SELF_REPORTED
  ESTIMATED
  ATTRIBUTED
}

enum SyncOrigin {
  SPONSORX
  ZOHO
}

/// §6 tier multipliers. Phase 1 sets these by hand; ANCHOR is negotiated and
/// therefore carries no derived sell floor (P0-PMO-13 §3).
enum AthleteTier {
  EMERGING
  CREATOR
  PREMIUM
  ANCHOR
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy and identity
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
}

model User {
  id         String   @id @default(cuid())
  tenantId   String
  /// Identity lives in Clerk; this row is the mirror. Never a password.
  clerkId    String   @unique
  email      String
  /// Authorization lives here, not in Clerk — §04.
  roles      Role[]
  athleteId  String?  @unique
  sponsorId  String?
  propertyId String?
  guardianId String?
  /// The same person's Zoho CRM user id (P8-INT-01, field-mapping O-5). Set
  /// by matching on email; a Task this user originates is owned by them in
  /// the CRM. Null means the API account owns it and nobody is notified.
  zohoUserId String?  @unique
  createdAt  DateTime @default(now())

  athlete     Athlete?              @relation(fields: [athleteId], references: [id])
  acceptances AgreementAcceptance[]

  @@index([tenantId])
  @@index([tenantId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Athlete network
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id        String  @id @default(cuid())
  tenantId  String
  /// Public profile URL.
  slug      String  @unique
  name      String
  /// TEAM | SCHOOL | EVENT | MEDIA | VIRTUAL
  kind      String
  city      String?
  /// US state code, e.g. "MD".
  stateCode String?

  // RESERVED, NOT WIRED (field-mapping S-9, decided 2026-09-24). §18 maps no
  // Property object and §6.2 sends the property to Zoho as plain text, so no
  // sync job reads or writes this column. Do not populate it by assuming it
  // is wired up; adopting it is a mapping change first.
  zohoId         String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?

  athletes     Athlete[]
  publications Publication[]

  @@index([tenantId])
}

model Guardian {
  id           String    @id @default(cuid())
  tenantId     String
  legalName    String
  email        String
  phone        String?
  /// PARENT | LEGAL_GUARDIAN | AUTHORIZED_REP
  relationship String
  /// §37 pre-pilot gate — a minor cannot go ACTIVE without this set.
  verifiedAt   DateTime?

  wards Athlete[]

  @@index([tenantId])
}

model Athlete {
  id           String    @id @default(cuid())
  tenantId     String
  /// Public profile URL.
  slug         String    @unique
  legalName    String
  displayName  String
  /// Drives the guardian path — under 18 at campaign start requires a Guardian.
  birthDate    DateTime?
  city         String?
  /// US state code, e.g. "MD". Geography, not lifecycle — see `state` below.
  stateCode    String?
  sport        String
  /// §11 §2 — position, level and achievements complete the Sports section.
  position     String?
  school       String?
  /// HIGH_SCHOOL | COLLEGE | SEMI_PRO | PRO | AMATEUR. A small vocabulary kept
  /// as text, matching Property.kind and Guardian.relationship — an enum here
  /// would need a migration every time a new competition level appears.
  level        String?
  gradYear     Int?
  achievements String?

  /// §11 §1 — the applicant's own contact details. Distinct from User.email,
  /// which belongs to the Clerk identity: an athlete may be onboarded by BTG
  /// long before they ever sign in, and a guardian-managed minor may never
  /// hold a login at all.
  email   String
  phone   String?
  /// §11 permits an age band instead of a date of birth. Both are optional in
  /// the column sense and the contract requires one of the two, because §26's
  /// guardian workflow cannot be decided without knowing whether the
  /// applicant is a minor.
  ageBand String?

  state AthleteState @default(DRAFT)

  /// §11 §10 — Compliance status. Reviewer notes are internal and shown to
  /// the applicant only when the state is CHANGES_REQUESTED. The expiry
  /// exists because §11 asks for it: a clearance that never expires is one
  /// nobody revisits.
  reviewerNotes        String?
  reviewedAt           DateTime?
  complianceExpiresAt  DateTime?
  /// §11 §4 — what this athlete can actually make. A queryable set rather
  /// than prose, because matching asks "who can shoot video" and a paragraph
  /// cannot answer it.
  contentCapabilities  String[]
  /// §11 §5 — categories they want to work with. Preference, not a rule.
  brandInterests       String[]
  /// §11 §6 — categories they will NOT promote. This one is a rule, and §26's
  /// conflict check reads it: Phase 4 asks "which athletes exclude alcohol?"
  /// and must get an answer from an index, not from someone reading notes.
  restrictedCategories String[]
  /// Anything that does not reduce to a category. Deliberately separate from
  /// the list above so nobody mistakes unenforceable text for an enforceable
  /// restriction — a conflict check cannot read this and must not appear to.
  restrictionNotes     String?

  /// §6 — set by a network manager in Phase 1, never computed.
  tier       AthleteTier?
  guardianId String?
  propertyId String?

  // Zoho (§18 — Contacts are bi-directional)
  zohoId         String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?

  createdAt DateTime @default(now())

  guardian Guardian?        @relation(fields: [guardianId], references: [id])
  property Property?        @relation(fields: [propertyId], references: [id])
  socials  AthleteSocial[]
  rates    AthleteRate[]
  scores   AthleteScore[]
  invites  CampaignInvite[]
  orders   CampaignOrder[]
  earnings Earning[]
  tokens   RewardToken[]
  user     User?

  @@index([tenantId, state])
  @@index([tenantId, sport, stateCode])
}

model AthleteSocial {
  id         String       @id @default(cuid())
  tenantId   String
  athleteId  String
  platform   String
  handle     String
  followers  Int?
  avgViews   Int?
  /// Phase 1 is largely SELF_REPORTED. The label is what keeps that honest.
  source     MetricSource @default(SELF_REPORTED)
  capturedAt DateTime     @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([athleteId, platform])
  @@index([tenantId])
}

/// §14 — a score is never stored without the factors that produced it.
model AthleteScore {
  id        String   @id @default(cuid())
  tenantId  String
  athleteId String
  /// 0–100
  score     Int
  /// engagement, quality, audience, reliability …
  factors   Json
  /// "rules-v1" — Phase 3 replaces the method, not the model.
  method    String
  scoredBy  String?
  scoredAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([athleteId, scoredAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial catalogue
// ─────────────────────────────────────────────────────────────────────────────

/// SX-01 … SX-07. Bands are integer cents.
///
/// The three sellFloor* columns are the P0-PMO-13 decision made durable: a
/// sell floor derived per tier as base-band top × tier multiplier × 1.4. They
/// are the published rate-card view. The binding rule at quote time is the
/// same formula against the athlete's AGREED rate, enforced by P3-BE-12 —
/// these columns tell a salesperson the worst case before they quote.
model NilJob {
  /// "SX-03"
  id       String @id
  tenantId String
  name     String
  baseLow  Int
  baseHigh Int
  sellLow  Int
  sellHigh Int

  sellFloorEmerging Int
  sellFloorCreator  Int
  sellFloorPremium  Int

  rates   AthleteRate[]
  invites CampaignInvite[]
  orders  CampaignOrder[]

  @@index([tenantId])
}

model AthleteRate {
  id        String @id @default(cuid())
  tenantId  String
  athleteId String
  jobId     String
  /// cents
  amount    Int
  version   Int    @default(1)

  athlete Athlete @relation(fields: [athleteId], references: [id])
  job     NilJob  @relation(fields: [jobId], references: [id])

  @@unique([athleteId, jobId, version])
  @@index([tenantId])
}

/// §7 — Test Drive … Season Partner.
///
/// `lineItems` is what P0-PMO-10 §2 said a package could not be sold without:
/// job codes and counts, e.g. [{ "jobCode": "SX-02", "quantityPerAthlete": 1 }].
/// Athlete count is a RANGE because the §7 packages are ranges, and the range
/// is precisely where the margin swing lived before the pricing decision.
model SponsorPackage {
  id              String  @id @default(cuid())
  tenantId        String
  code            String
  name            String
  priceLow        Int
  priceHigh       Int
  athleteCountMin Int
  athleteCountMax Int
  lineItems       Json
  /// Non-NIL inventory sold alongside the jobs, e.g. an iMC/BTG feature.
  includes        Json?
  exclusivity     Boolean @default(false)
  durationWeeks   Int?
  active          Boolean @default(true)

  briefs CampaignBrief[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Sponsor {
  id       String @id @default(cuid())
  tenantId String
  name     String

  // Zoho (§18 — Accounts are bi-directional)
  zohoAccountId  String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  /// When the last sync in either direction succeeded. With `updatedAt` this
  /// is the concurrent-change test (field-mapping §8.1 step 3).
  lastSyncAt     DateTime?
  updatedAt      DateTime    @default(now()) @updatedAt

  briefs    CampaignBrief[]
  campaigns Campaign[]
  contacts  SponsorContact[]

  @@index([tenantId])
}

/// The people at a sponsor — P4-BE-01, §18, §20.
///
/// Separate from `User`: a sponsor contact is someone BTG sells to and Zoho
/// knows about, and most of them never sign in. Folding them into `User`
/// would mean every Zoho Contact arriving as a login-capable account.
model SponsorContact {
  id        String  @id @default(cuid())
  tenantId  String
  sponsorId String
  name      String
  email     String
  phone     String?
  /// Job title as the sponsor gives it. Free text — normalising it would be
  /// inventing a taxonomy nobody asked for.
  title     String?
  /// Who to write to by default. Not unique at the database: a sponsor
  /// mid-handover legitimately has two for a while, and refusing that would
  /// block a sync Zoho has already accepted.
  isPrimary Boolean @default(false)

  // Zoho (§18 — Contacts are bi-directional)
  zohoContactId  String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  @@index([tenantId, sponsorId])
  @@index([tenantId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Brief → matching → campaign
// ─────────────────────────────────────────────────────────────────────────────

/// §13 step 2.
model CampaignBrief {
  id         String     @id @default(cuid())
  tenantId   String
  sponsorId  String
  objective  String
  /// cents
  budget     Int
  packageId  String?
  startDate  DateTime
  endDate    DateTime
  sports     String[]
  /// US state codes targeted by the brief.
  stateCodes String[]
  /// Conflict-check input — §26.
  categories String[]
  state      BriefState @default(DRAFT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  // Zoho (§18 rows 4–5). The Deal is created when the brief qualifies, before
  // any Campaign exists, so the brief holds it; the campaign copies it on
  // creation and owns it from then on (field-mapping §4.1, S-3, S-8).
  zohoDealId     String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?

  sponsor  Sponsor         @relation(fields: [sponsorId], references: [id])
  package  SponsorPackage? @relation(fields: [packageId], references: [id])
  campaign Campaign?

  @@index([tenantId, state])
}

model Campaign {
  id        String        @id @default(cuid())
  tenantId  String
  sponsorId String
  briefId   String?       @unique
  name      String
  /// cents
  budget    Int
  startDate DateTime
  endDate   DateTime
  state     CampaignState @default(DRAFT)

  // Zoho (§18 — Deals are bi-directional)
  zohoDealId        String?     @unique
  lastSyncOrigin    SyncOrigin?
  lastSyncHash      String?
  lastSyncAt        DateTime?
  /// §18 row 9 — the renewal is a second Deal, pushed once, never read back.
  zohoRenewalDealId String?     @unique
  updatedAt         DateTime    @default(now()) @updatedAt

  sponsor  Sponsor           @relation(fields: [sponsorId], references: [id])
  brief    CampaignBrief?    @relation(fields: [briefId], references: [id])
  invites  CampaignInvite[]
  orders   CampaignOrder[]
  rewards  Reward[]
  invoices CampaignInvoice[]
  /// SponsorX NEXT — the ad positions this campaign bought (P9-BE-03).
  adSlots  AdSlot[]

  @@index([tenantId, state])
}

/// §21 — INVITED → VIEWED → ACCEPTED / DECLINED / EXPIRED.
model CampaignInvite {
  id          String      @id @default(cuid())
  tenantId    String
  campaignId  String
  athleteId   String
  jobId       String
  /// cents
  offered     Int
  state       InviteState @default(INVITED)
  sentAt      DateTime    @default(now())
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime

  campaign Campaign @relation(fields: [campaignId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])
  job      NilJob   @relation(fields: [jobId], references: [id])

  /// NO full @@unique here on purpose. "One invite per athlete per job, ever"
  /// would forbid re-inviting an athlete whose previous invitation EXPIRED or
  /// was DECLINED, which is ordinary business. The rule actually wanted is one
  /// OPEN invite at a time, and that needs a partial unique index — see
  /// prisma/sql/invite_one_open.sql (P2-BE-03).
  @@index([tenantId, state, expiresAt])
  @@index([campaignId, athleteId, jobId])
}

/// The commercial record, one per athlete per job.
model CampaignOrder {
  id           String   @id @default(cuid())
  tenantId     String
  campaignId   String
  athleteId    String
  jobId        String
  /// cents — the agreed athlete compensation, not the sponsor price.
  compensation Int
  /// cents — what the sponsor pays for THIS line.
  ///
  /// Added 2026-09-22 for P3-BE-12. Its acceptance is "refuse a line whose
  /// sponsor price is below athlete cost x 1.4", and there was no per-line
  /// sponsor price to refuse against — only the campaign budget, which lets a
  /// campaign with room hide one underwater line behind several cheap ones.
  /// The 1.4x rule itself was settled by P0-PMO-13; this is the column it
  /// needed.
  sellPrice    Int
  usageRights  String
  exclusivity  String?
  dueDate      DateTime

  /// What we expected this line to reach, FROZEN AT CREATION — P7-DATA-03.
  ///
  /// Frozen for the same reason `compensation` and `sellPrice` are: the
  /// projection comes from the athlete's own follower and view figures, which
  /// move. Recomputing later answers "what would we project today", and the
  /// question worth learning from is "what did we think this was worth when
  /// we sold it". A derived number is normally not stored in this codebase
  /// (see the metric rollup); this one is an exception because it is a
  /// historical fact about a sale rather than an aggregate over rows.
  ///
  /// Null where the athlete had no usable audience figure. An absent
  /// projection is honest; a zero would be a claim.
  projectedImpressions Int?
  /// cents per thousand projected impressions. Derived from `sellPrice` and
  /// `projectedImpressions`, stored alongside them so the arithmetic that
  /// produced it can be checked later.
  impliedCpm           Int?
  /// The provenance of the PROJECTION — usually SELF_REPORTED in Phase 1,
  /// because that is what an athlete's follower count is. Carried so no
  /// report can present an implied CPM as though it rested on verified
  /// reach (§22).
  projectionSource     MetricSource?
  state                OrderState    @default(DRAFT)
  acceptedAt           DateTime?
  acceptanceId         String?       @unique

  campaign     Campaign             @relation(fields: [campaignId], references: [id])
  athlete      Athlete              @relation(fields: [athleteId], references: [id])
  job          NilJob               @relation(fields: [jobId], references: [id])
  acceptance   AgreementAcceptance? @relation(fields: [acceptanceId], references: [id])
  deliverables Deliverable[]
  earning      Earning?

  @@unique([campaignId, athleteId, jobId])
  @@index([tenantId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery
// ─────────────────────────────────────────────────────────────────────────────

model Deliverable {
  id           String           @id @default(cuid())
  tenantId     String
  orderId      String
  title        String
  dueDate      DateTime
  state        DeliverableState @default(NOT_STARTED)
  publishedUrl String?
  publishedAt  DateTime?

  order   CampaignOrder   @relation(fields: [orderId], references: [id])
  assets  CreativeAsset[]
  link    TrackingLink?
  metrics MetricDaily[]

  @@index([tenantId, state, dueDate])
}

model CreativeAsset {
  id            String   @id @default(cuid())
  tenantId      String
  deliverableId String
  version       Int
  /// Private bucket; signed-URL access only (§11). Never a public URL.
  r2Key         String
  /// §12 — pre-derived sizes, since next/image optimization is not adopted.
  derivatives   Json?
  uploadedBy    String
  uploadedAt    DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@unique([deliverableId, version])
  @@index([tenantId])
}

model MetricDaily {
  id            String       @id @default(cuid())
  tenantId      String
  deliverableId String
  day           DateTime     @db.Date
  views         Int          @default(0)
  engagements   Int          @default(0)
  source        MetricSource
  enteredBy     String?

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  /// Same day, same deliverable, different source is a DIFFERENT row — a
  /// manually verified figure never silently overwrites an API one.
  @@unique([deliverableId, day, source])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// The two funnels — kept apart on purpose
//
// A tracking link measures AN ATHLETE'S DELIVERABLE. A reward token measures
// A FAN'S JOURNEY. V1 collapsed them and wrote a TrackingLink id into a field
// that foreign-keys RewardToken; that bug is the reason these are separate.
// ─────────────────────────────────────────────────────────────────────────────

model TrackingLink {
  id             String @id @default(cuid())
  tenantId       String
  /// Short and opaque. Never the record id.
  code           String @unique
  deliverableId  String @unique
  destinationUrl String

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  events      LinkEvent[]

  @@index([tenantId])
}

/// Athlete-attribution clicks. Geo resolved in a worker job (§06), never from
/// request headers — those are host-specific and Railway does not send them.
model LinkEvent {
  id       String   @id @default(cuid())
  tenantId String
  linkId   String
  at       DateTime @default(now())
  city     String?
  region   String?

  link TrackingLink @relation(fields: [linkId], references: [id])

  @@index([tenantId, linkId, at])
}

model Reward {
  id         String      @id @default(cuid())
  tenantId   String
  campaignId String
  offerText  String
  singleUse  Boolean     @default(true)
  expiresAt  DateTime
  terms      String
  state      RewardState @default(DRAFT)

  campaign Campaign      @relation(fields: [campaignId], references: [id])
  tokens   RewardToken[]

  @@index([tenantId, state])
}

model RewardToken {
  id        String  @id @default(cuid())
  tenantId  String
  rewardId  String
  /// Per-athlete attribution — which athlete's QR produced this journey.
  athleteId String?
  /// Opaque, never the record id.
  token     String  @unique
  /// R2 object in the private bucket.
  qrKey     String?

  reward  Reward        @relation(fields: [rewardId], references: [id])
  athlete Athlete?      @relation(fields: [athleteId], references: [id])
  events  RewardEvent[]

  @@index([tenantId])
}

/// One row per event. The single-use rule is enforced by a partial unique
/// index on (tokenId) WHERE type = 'REDEEM' — P2-BE-03, not this file. An
/// application-level "already redeemed?" check loses the race; an index does
/// not.
model RewardEvent {
  id       String          @id @default(cuid())
  tenantId String
  tokenId  String
  type     RewardEventType
  at       DateTime        @default(now())
  city     String?
  region   String?
  /// The ONLY fan PII this system holds, and it is optional — §16's page has
  /// no login and asking for an address as a condition of claiming would be a
  /// barrier at a stall. It may only be set together with the three consent
  /// columns below (P6-SEC-01); `recordClaim` refuses otherwise.
  fanEmail String?

  /// Consent, captured at the moment of the claim — P6-SEC-01, §26.
  ///
  /// THE VERSION IS THE POINT. "They consented" is not a defensible record
  /// three months later when the wording has been edited twice; "they
  /// consented to version 2026-09-01 at this timestamp" is. The version
  /// string is the identity of the text that was actually on screen.
  ///
  /// All three are null where no email was given — there is nothing to
  /// consent to holding.
  consentVersion     String?
  consentAt          DateTime?
  /// What the fan was told the address would be used for, as a short code
  /// (e.g. "reward-delivery"). Consent is scoped: agreeing to be sent a
  /// voucher is not agreeing to marketing, and a single boolean would lose
  /// that distinction the first time someone exported the list.
  consentPurpose     String?
  /// When the fan withdrew that consent (P6-SEC-03) — the one-tap unsubscribe
  /// link in every fan email. Recorded on THIS row, beside the consent it
  /// withdraws, so the record reads "agreed to 2026-09-01 at T1, withdrew at
  /// T2" in one place. Every query that contacts a fan filters on it being
  /// null (`CONTACTABLE` in domain/fan-consent.ts).
  consentWithdrawnAt DateTime?

  token RewardToken @relation(fields: [tokenId], references: [id])

  @@index([tenantId, type, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Money, agreements, plumbing
// ─────────────────────────────────────────────────────────────────────────────

/// Phase 1 tracks earnings STATUS only. No tax ID, no bank details, ever —
/// §26 and Addendum A6. `reference` holds a Zoho or bank reference, which is
/// a pointer, not a credential.
model Earning {
  id         String       @id @default(cuid())
  tenantId   String
  athleteId  String
  orderId    String       @unique
  /// cents
  gross      Int
  adjustment Int          @default(0)
  state      EarningState @default(PENDING)
  taxYear    Int
  paidAt     DateTime?
  reference  String?

  order   CampaignOrder @relation(fields: [orderId], references: [id])
  athlete Athlete       @relation(fields: [athleteId], references: [id])

  /// Year-end reporting rollup.
  @@index([athleteId, taxYear])
  @@index([tenantId, state])
}

/// A versioned agreement template. `bodyHash` is the sha256 of the exact text
/// shown, so a later wording change can never be mistaken for what somebody
/// actually agreed to.
model Agreement {
  id          String   @id @default(cuid())
  tenantId    String
  /// COLLAB | CAMPAIGN_ORDER | GUARDIAN | RELEASE
  kind        String
  version     Int
  bodyHash    String
  effectiveAt DateTime

  acceptances AgreementAcceptance[]

  @@unique([tenantId, kind, version])
}

model AgreementAcceptance {
  id          String   @id @default(cuid())
  tenantId    String
  agreementId String
  userId      String
  /// Copied at accept time, not read back through the template.
  bodyHash    String
  ip          String
  userAgent   String
  acceptedAt  DateTime @default(now())
  /// Set when the athlete is a minor — §4.
  guardianId  String?

  agreement Agreement      @relation(fields: [agreementId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  order     CampaignOrder?

  @@index([tenantId, agreementId])
}

/// The transactional outbox (§05). A job is written in the same transaction as
/// the work that causes it, and drained separately — so Zoho being down never
/// touches a request path.
model OutboxJob {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  payload      Json
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([tenantId])
}

/// Invoices and payment status, MIRRORED from Zoho — P7-BE-04, §18.
///
/// SPONSORX IS NOT THE INVOICE SYSTEM OF RECORD, and this model is shaped to
/// make that hard to forget. Every row is a copy of something Zoho Books owns:
/// there is no line-item table, no tax field, no totalling logic and no way to
/// issue or amend an invoice here. `zohoInvoiceId` is unique because the Zoho
/// record is the identity — this table has no identity of its own to defend.
///
/// It exists so that "has this campaign been paid?" can be answered without a
/// request to Zoho on a page load (§18 keeps Zoho off every request path).
/// When the two disagree, Zoho is right and the next sync corrects this.
model CampaignInvoice {
  id         String @id @default(cuid())
  tenantId   String
  campaignId String

  /// The Zoho Books invoice. Unique: it is the real identity of this row.
  zohoInvoiceId String  @unique
  /// Human-facing number as Zoho issued it, e.g. "INV-000042".
  number        String?
  /// Zoho's own status string, copied verbatim rather than re-modelled —
  /// draft | sent | overdue | paid | void. Mapping it onto an enum of ours
  /// would mean maintaining a translation that silently drops any status
  /// Zoho adds later.
  status        String
  /// cents
  amount        Int
  currency      String  @default("USD")

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  /// §18 loop prevention — which side wrote last, and a hash of what was
  /// written, so an echo of our own update is recognised and dropped.
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  syncedAt       DateTime    @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([tenantId, status])
  @@index([campaignId])
}

/// §20 — inbound Zoho attempts, recorded whether or not they were accepted.
/// tenantId is nullable because a webhook is logged before it is known which
/// tenant it resolves to; recording the rejected ones is the point.
model WebhookDelivery {
  id          String   @id @default(cuid())
  tenantId    String?
  /// "zoho"
  source      String
  externalId  String?
  signatureOk Boolean
  payload     Json
  /// RECEIVED | APPLIED | REJECTED | FAILED
  status      String
  error       String?
  receivedAt  DateTime @default(now())

  @@index([source, receivedAt])
}

/// An inbound sponsor enquiry — §18 row 3, P8-INT-06, field-mapping §7.3/S-2.
/// Pushed one-way to Zoho Leads; qualification happens in the CRM. A sponsor
/// enquiry, not a fan: fan-consent lead capture is Phase 2 (2S6-INT-03).
model Inquiry {
  id          String   @id @default(cuid())
  tenantId    String
  companyName String?
  firstName   String?
  lastName    String
  email       String
  phone       String?
  message     String?
  /// "web-form" | "outbound" | "event"
  source      String
  zohoLeadId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId, createdAt])
}

/// A CRM task SponsorX originates — §18 row 7, field-mapping §7.5/S-4.
/// Follow-ups, approvals and renewals. Tasks staff create in Zoho stay there.
/// Deal and contact links are held as OUR ids and resolved to Zoho ids at
/// push time, because the task is usually created before its deal reaches
/// Zoho — a stored Zoho id would be null exactly when it is needed.
model SyncTask {
  id             String      @id @default(cuid())
  tenantId       String
  /// FOLLOW_UP | APPROVAL | RENEWAL
  kind           String
  subject        String
  body           String?
  dueDate        DateTime
  completedAt    DateTime?
  /// → User.zohoUserId as the CRM Owner.
  assigneeUserId String?
  briefId        String?
  campaignId     String?
  zohoTaskId     String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  /// `<kind>:<brief or campaign id>`, e.g. `approval:c_123`. One task per
  /// event: a retried transition must not raise a second CRM task.
  dedupeKey String @unique

  @@index([tenantId, dueDate])
}

/// The nightly drift report — P8-INT-05, field-mapping §8.3. One row per
/// module per run. Reported, never auto-repaired: repairing a mapping this
/// new would paper over the bug that caused the drift.
model ZohoReconciliation {
  id                String   @id @default(cuid())
  tenantId          String
  /// Accounts | Contacts | Deals | Tasks
  module            String
  ranAt             DateTime @default(now())
  checked           Int
  /// Our ids with no Zoho record — a lost push.
  missingInZoho     Json
  /// Zoho ids carrying a SponsorX_ID we do not recognise.
  unknownInSponsorX Json
  /// Present on both sides, shared fields disagree — a missed webhook.
  diverged          Json

  @@index([tenantId, ranAt])
}

/// Sent-email ledger (P3-INT-01). Not a copy of the message — the key, the
/// template and the recipient only, because §26 is clear that personal data
/// should not accumulate in places nobody thinks to look.
///
/// Its whole job is idempotency: outbox delivery is at-least-once and pg-boss
/// retries, so the handler claims a key here before sending and refuses a key
/// it has already claimed. Without it a redelivered job emails a person twice,
/// and "your application was rejected" twice is its own small harm.
model EmailSendLog {
  idempotencyKey String   @id
  tenantId       String
  template       String
  to             String
  sentAt         DateTime @default(now())

  @@index([tenantId, sentAt])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// SponsorX NEXT — publications, editions and their inventory (Stage 9 Batch A:
// P9-BE-02, -03, -06, -12). Spec v2.0 §5.2, §5.7, §6.4. The Stage 9 schema
// gate (P9-PMO-03) was lifted by the programme owner on 2026-09-25.
// ─────────────────────────────────────────────────────────────────────────────

/// The masthead. Per school (`propertyId`), or regional with `propertyId`
/// null for the DMV edition (§5.2).
model Publication {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String?
  name       String
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  editions Edition[]

  @@index([tenantId])
}

/// Fall / Winter / Spring / Year-End. The three V3 §3 production conditions
/// are explicit columns, not a computed opinion.
model Edition {
  id             String       @id @default(cuid())
  tenantId       String
  publicationId  String
  label          String
  /// Ad deadline — no slot sells on or after it (database-enforced).
  closeDate      DateTime
  publishTarget  DateTime
  printDate      DateTime?
  pageCount      Int?
  contentReady   Boolean      @default(false)
  rightsCleared  Boolean      @default(false)
  revenueMet     Boolean      @default(false)
  /// cents — the minimum viable edition threshold
  thresholdCents Int
  state          EditionState @default(PLANNING)

  publication Publication    @relation(fields: [publicationId], references: [id])
  slots       AdSlot[]
  splits      RevenueSplit[]
  events      EditionEvent[]

  @@index([tenantId, state])
}

/// P9-BE-02. V1 is a free digital edition; print is an optional layer.
enum EditionState {
  PLANNING
  SELLING
  CLOSED
  IN_PRODUCTION
  PUBLISHED_DIGITAL
  PRINTED
  DISTRIBUTED
  CANCELLED
}

/// The inventory ledger — one row per sellable position (P9-BE-03). It points
/// at the Campaign, not a CampaignOrder: an order needs an athlete and a job,
/// and an ad has neither. Selling twice, selling after close, and a second
/// back cover are all refused by Postgres (migration 20260925120000).
model AdSlot {
  id         String     @id @default(cuid())
  tenantId   String
  editionId  String
  /// "P04-QTR" — the position on the flatplan.
  slotCode   String
  kind       AdSlotKind
  /// cents — rack price
  priceCents Int
  /// Positions this row represents. Always 1: several identical positions
  /// are several rows, so each can be sold on its own (CHECK in migration).
  quantity   Int        @default(1)
  campaignId String?
  /// cents — frozen at sale; may differ from rack (an add-on sold with it).
  soldCents  Int?
  soldAt     DateTime?

  edition  Edition   @relation(fields: [editionId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([editionId, slotCode])
  @@index([tenantId, editionId])
  @@index([campaignId])
}

/// Matches the AD_SLOT / PRESENTING codes in the NEXT packages' `includes`.
enum AdSlotKind {
  QUARTER
  HALF
  FULL
  BACK_COVER
  PRESENTING
}

/// P9-BE-06, §5.7. Attached to the edition. NOT Earning — Earning is athlete
/// NIL pay that finance reconciles payouts from, and schools and pools must
/// never land in it.
model RevenueSplit {
  id          String         @id @default(cuid())
  tenantId    String
  editionId   String
  payeeKind   SplitPayeeKind
  /// basis points of the edition's sold revenue; the four sum to 10,000
  bps         Int
  /// cents — computed at close, never typed in
  amountCents Int
  computedAt  DateTime       @default(now())

  edition Edition @relation(fields: [editionId], references: [id])

  @@unique([editionId, payeeKind])
  @@index([tenantId])
}

enum SplitPayeeKind {
  SPONSORX
  SCHOOL
  STUDENT_POOL
  EDITORIAL_FUND
}

/// P9-BE-12, §6.4. Its own stream — NOT RewardEventType, which is a fan's
/// journey through a reward token. Aggregate-only: no fan identity here.
model EditionEvent {
  id         String         @id @default(cuid())
  tenantId   String
  editionId  String
  /// AD_SLOT | ARTICLE | ATHLETE_PROFILE
  targetKind String
  targetRef  String
  type       EngagementType
  at         DateTime       @default(now())
  city       String?
  region     String?

  edition Edition @relation(fields: [editionId], references: [id])

  @@index([tenantId, editionId, type, at])
  @@index([targetKind, targetRef])
}

/// Print and digital acquisition stay distinct — principle 8. QR_SCAN is
/// print; the rest are digital. Pooling them makes the first sponsor report
/// say something untrue.
enum EngagementType {
  QR_SCAN
  LINK_CLICK
  PROFILE_VIEW
  CAMPAIGN_VIEW
  CTA_CLICK
}
