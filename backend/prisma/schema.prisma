// SponsorX — Prisma schema (P2-BE-02)
//
// Source: Implementation Guide V2 §03, reconciled against the eight §21 state
// machines in documentation/diagrams/state-machines/ and the pricing decision
// in documentation/SponsorX-Pricing-Floor-Decision.md (P0-PMO-13).
//
// FOUR CONVENTIONS, applied without exception:
//
//   1. `tenantId` on every model except Tenant itself. It is a plain column,
//      not a relation, exactly as §03 has it — enforcement is the job of the
//      scope functions (§04) and the authorization matrix (§09), and 25 foreign
//      keys back to one table buys nothing that a discipline plus a test does
//      not. WebhookDelivery.tenantId is the one nullable case: an inbound Zoho
//      webhook is recorded before it is known which tenant it belongs to, and
//      recording it anyway is the point of the model.
//
//   2. State enums lifted verbatim from §21. Every value in the eight .mmd
//      files appears below and nothing else does.
//
//   3. External IDs plus `lastSyncOrigin` and `lastSyncHash` on every model
//      Zoho touches — §18 makes Accounts, Contacts, Deals and Tasks
//      bi-directional, so that is Sponsor, Athlete, Property and Campaign.
//      §03 gave markers to only two of the four; the other two are corrected
//      here.
//
//   4. Events are rows, never counters. RewardEvent, LinkEvent and MetricDaily
//      each store one row per occurrence so the four-event fan funnel (§16)
//      stays separable after the fact.
//
// MONEY IS INTEGER CENTS throughout. No floats, anywhere, ever.
//
// ONE CORRECTION TO §03: the guide gives Athlete both `state String?` (the US
// state) and `state_ AthleteState @map("state")` (the lifecycle). Those collide
// on the same column and the schema will not compile. Geography is `stateCode`
// here — on Athlete, Property and CampaignBrief alike — and `state` means the
// lifecycle enum on every model without exception.
//
// WHAT IS DELIBERATELY NOT HERE: the three partial indexes Prisma cannot
// express — single-use reward redemption, the outbox drain and the one-open-
// invite rule. They are `P2-BE-03` and live in prisma/sql/, applied by their
// own migration. Adding them here would mean writing raw SQL into a file that
// is supposed to be the model.

generator client {
  provider = "prisma-client"

  // Explicit output path (Guide §02). Gitignored — generated, never committed.
  // Relative to this schema (backend/prisma/) → backend/src/generated/prisma.
  output = "../src/generated/prisma"
}

// REMOVED 2026-09-21 — there was a second generator here emitting a client into
// frontend/src/generated/prisma. It existed because, at the split, the frontend
// still queried Postgres directly.
//
// It does not any more: authorisation and every database read moved to this
// workspace (Addendum B), and the frontend reaches them over /api/v1. A second
// generated client would be a second way into the database from a workspace
// that must not have one — precisely the hazard that move removed — so the
// generator is gone rather than merely unused.

// Prisma 7: `url` is NOT permitted here any more. The connection string for
// Migrate lives in prisma.config.ts, and PrismaClient itself is constructed
// with an adapter. See https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — §21 state machines, verbatim
// ─────────────────────────────────────────────────────────────────────────────

/// Authorization lives here and in user_roles, never in Clerk (§04, Addendum A4).
/// STUDENT and ADVISOR are SponsorX NEXT's (P9-BE-05, matrix §15.1): a
/// student correspondent is not an ATHLETE, and a faculty advisor is not a
/// PROPERTY_MGR.
enum Role {
  SUPER_ADMIN
  BTG_ADMIN
  SALES
  CAMPAIGN_MGR
  NETWORK_MGR
  FINANCE
  ATHLETE
  GUARDIAN
  PROPERTY_MGR
  SPONSOR_ADMIN
  SPONSOR_ANALYST
  SERVICE
  STUDENT
  ADVISOR
}

enum AthleteState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ACTIVE
  SUSPENDED
  FEATURED
}

enum BriefState {
  DRAFT
  QUALIFIED
  APPROVED
  CAMPAIGN_CREATED
  CLOSED
}

enum InviteState {
  INVITED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum CampaignState {
  DRAFT
  STAFFING
  APPROVAL
  ACTIVE
  REPORTING
  COMPLETED
  CANCELLED
}

enum OrderState {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeliverableState {
  NOT_STARTED
  DRAFT_SUBMITTED
  BTG_REVIEW
  SPONSOR_REVIEW
  APPROVED
  PUBLISHED
  VERIFIED
}

enum EarningState {
  PENDING
  ELIGIBLE
  APPROVED_FOR_PAYOUT
  PAID
  HELD
  DISPUTED
}

enum RewardState {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

/// Four distinct events across the fan journey (§16). Never one counter.
enum RewardEventType {
  SCAN
  LANDING
  CLAIM
  REDEEM
}

/// The provenance taxonomy (P0-DATA-01). Every displayed number carries one.
enum MetricSource {
  VERIFIED_API
  VERIFIED_MANUAL
  SELF_REPORTED
  ESTIMATED
  ATTRIBUTED
}

enum SyncOrigin {
  SPONSORX
  ZOHO
}

/// §6 tier multipliers. Phase 1 sets these by hand; ANCHOR is negotiated and
/// therefore carries no derived sell floor (P0-PMO-13 §3).
enum AthleteTier {
  EMERGING
  CREATOR
  PREMIUM
  ANCHOR
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy and identity
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id               String   @id @default(cuid())
  name             String
  createdAt        DateTime @default(now())
  /// Phase 2 (2S3-BE-01) — the tenant that runs the marketplace this one sells
  /// in: BTG's, for an organisation BTG approved (2S1-BE-04). Null for BTG's
  /// own tenant. BTG staff review the inventory and listings of the tenants
  /// they operate — the `operated` scope — and nothing else of theirs.
  operatorTenantId String?

  inventoryItems    InventoryItem[]
  listings          Listing[]
  brandRestrictions BrandRestriction[]

  @@index([operatorTenantId])
}

model User {
  id         String   @id @default(cuid())
  tenantId   String
  /// Identity lives in Clerk; this row is the mirror. Never a password.
  clerkId    String   @unique
  email      String
  /// Authorization lives here, not in Clerk — §04.
  roles      Role[]
  athleteId  String?  @unique
  sponsorId  String?
  propertyId String?
  guardianId String?
  /// SponsorX NEXT (P9-BE-05): a STUDENT's own record — without it every
  /// student-scoped row matches nothing. A STUDENT's propertyId is their school.
  studentId  String?  @unique
  /// The same person's Zoho CRM user id (P8-INT-01, field-mapping O-5). Set
  /// by matching on email; a Task this user originates is owned by them in
  /// the CRM. Null means the API account owns it and nobody is notified.
  zohoUserId String?  @unique
  createdAt  DateTime @default(now())

  athlete     Athlete?              @relation(fields: [athleteId], references: [id])
  acceptances AgreementAcceptance[]

  @@index([tenantId])
  @@index([tenantId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Athlete network
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id        String  @id @default(cuid())
  tenantId  String
  /// Public profile URL.
  slug      String  @unique
  name      String
  /// TEAM | SCHOOL | EVENT | MEDIA | VIRTUAL
  kind      String
  city      String?
  /// US state code, e.g. "MD".
  stateCode String?

  // WIRED BY 2S7-INT-01 (2026-09-28). Was reserved (field-mapping S-9,
  // 2026-09-24): §18 mapped no Property object. Phase 2's outside properties
  // are Accounts in their own right, so the mapping change was made first
  // (field-mapping §13) and zoho.pushMarketplaceOrder now writes this — the
  // property's Zoho Account id. SponsorX pushes it; nothing reads it back.
  zohoId         String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  /// 2S7-INT-01 — the property manager's Contact in Zoho, under the Account
  /// `zohoId` (adopted by 2S7-INT-01; field-mapping §13).
  zohoContactId  String?     @unique

  athletes        Athlete[]
  publications    Publication[]
  students        Student[]
  roster          RosterEntry[]
  /// Phase 2 (2S1-BE-03) — set when BTG approves the property's onboarding,
  /// cleared on suspension. Listing creation (2S3-BE-01) requires it.
  listingAccessAt DateTime?
  onboarding      PropertyOnboarding?
  inventory       InventoryItem[]
  listings        Listing[]
  restrictions    BrandRestriction[]

  @@index([tenantId])
}

model Guardian {
  id           String    @id @default(cuid())
  tenantId     String
  legalName    String
  email        String
  phone        String?
  /// PARENT | LEGAL_GUARDIAN | AUTHORIZED_REP
  relationship String
  /// §37 pre-pilot gate — a minor cannot go ACTIVE without this set.
  verifiedAt   DateTime?

  wards    Athlete[]
  /// SponsorX NEXT — reused unchanged: a minor student needs a verified
  /// guardian on the same rule as an athlete (P9-BE-04).
  students Student[]

  @@index([tenantId])
}

model Athlete {
  id           String    @id @default(cuid())
  tenantId     String
  /// Public profile URL.
  slug         String    @unique
  legalName    String
  displayName  String
  /// Drives the guardian path — under 18 at campaign start requires a Guardian.
  birthDate    DateTime?
  city         String?
  /// US state code, e.g. "MD". Geography, not lifecycle — see `state` below.
  stateCode    String?
  sport        String
  /// §11 §2 — position, level and achievements complete the Sports section.
  position     String?
  school       String?
  /// HIGH_SCHOOL | COLLEGE | SEMI_PRO | PRO | AMATEUR. A small vocabulary kept
  /// as text, matching Property.kind and Guardian.relationship — an enum here
  /// would need a migration every time a new competition level appears.
  level        String?
  gradYear     Int?
  achievements String?

  /// §11 §1 — the applicant's own contact details. Distinct from User.email,
  /// which belongs to the Clerk identity: an athlete may be onboarded by BTG
  /// long before they ever sign in, and a guardian-managed minor may never
  /// hold a login at all.
  /// NULL only for a FEATURED athlete (P9-BE-11): editorial created them and
  /// has no contact for them until they claim the profile.
  email   String?
  phone   String?
  /// §11 permits an age band instead of a date of birth. Both are optional in
  /// the column sense and the contract requires one of the two, because §26's
  /// guardian workflow cannot be decided without knowing whether the
  /// applicant is a minor.
  ageBand String?

  state AthleteState @default(DRAFT)

  /// §11 §10 — Compliance status. Reviewer notes are internal and shown to
  /// the applicant only when the state is CHANGES_REQUESTED. The expiry
  /// exists because §11 asks for it: a clearance that never expires is one
  /// nobody revisits.
  reviewerNotes        String?
  reviewedAt           DateTime?
  complianceExpiresAt  DateTime?
  /// §11 §4 — what this athlete can actually make. A queryable set rather
  /// than prose, because matching asks "who can shoot video" and a paragraph
  /// cannot answer it.
  contentCapabilities  String[]
  /// §11 §5 — categories they want to work with. Preference, not a rule.
  brandInterests       String[]
  /// §11 §6 — categories they will NOT promote. This one is a rule, and §26's
  /// conflict check reads it: Phase 4 asks "which athletes exclude alcohol?"
  /// and must get an answer from an index, not from someone reading notes.
  restrictedCategories String[]
  /// Anything that does not reduce to a category. Deliberately separate from
  /// the list above so nobody mistakes unenforceable text for an enforceable
  /// restriction — a conflict check cannot read this and must not appear to.
  restrictionNotes     String?

  /// §6 — set by a network manager in Phase 1, never computed.
  tier         AthleteTier?
  guardianId   String?
  propertyId   String?
  /// Phase 2 (2S2-BE-04) — the team's share of what this athlete earns through
  /// it, in basis points (0–10000). Set by the team manager; the ledger
  /// (2S5-BE-02) applies it. Null for an athlete with no team.
  teamShareBps Int?

  // Zoho (§18 — Contacts are bi-directional)
  zohoId         String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?

  createdAt DateTime @default(now())

  guardian     Guardian?             @relation(fields: [guardianId], references: [id])
  property     Property?             @relation(fields: [propertyId], references: [id])
  socials      AthleteSocial[]
  rates        AthleteRate[]
  scores       AthleteScore[]
  invites      CampaignInvite[]
  orders       CampaignOrder[]
  earnings     Earning[]
  tokens       RewardToken[]
  user         User?
  /// An athlete correspondent is also a Student (P9-BE-04).
  student      Student?
  /// SponsorX NEXT (P9-BE-11) — consent recorded for this athlete as a
  /// subject, and claims made on a FEATURED profile.
  consents     AgreementAcceptance[]
  claims       AthleteClaim[]
  inventory    InventoryItem[]
  offers       Offer[]
  restrictions BrandRestriction[]

  @@index([tenantId, state])
  @@index([tenantId, sport, stateCode])
}

model AthleteSocial {
  id         String       @id @default(cuid())
  tenantId   String
  athleteId  String
  platform   String
  handle     String
  followers  Int?
  avgViews   Int?
  /// Phase 1 is largely SELF_REPORTED. The label is what keeps that honest.
  source     MetricSource @default(SELF_REPORTED)
  capturedAt DateTime     @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([athleteId, platform])
  @@index([tenantId])
}

/// §14 — a score is never stored without the factors that produced it.
model AthleteScore {
  id        String   @id @default(cuid())
  tenantId  String
  athleteId String
  /// 0–100
  score     Int
  /// engagement, quality, audience, reliability …
  factors   Json
  /// "rules-v1" — Phase 3 replaces the method, not the model.
  method    String
  scoredBy  String?
  scoredAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([athleteId, scoredAt])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Commercial catalogue
// ─────────────────────────────────────────────────────────────────────────────

/// SX-01 … SX-07. Bands are integer cents.
///
/// The three sellFloor* columns are the P0-PMO-13 decision made durable: a
/// sell floor derived per tier as base-band top × tier multiplier × 1.4. They
/// are the published rate-card view. The binding rule at quote time is the
/// same formula against the athlete's AGREED rate, enforced by P3-BE-12 —
/// these columns tell a salesperson the worst case before they quote.
model NilJob {
  /// "SX-03"
  id       String @id
  tenantId String
  name     String
  baseLow  Int
  baseHigh Int
  sellLow  Int
  sellHigh Int

  sellFloorEmerging Int
  sellFloorCreator  Int
  sellFloorPremium  Int

  rates   AthleteRate[]
  invites CampaignInvite[]
  orders  CampaignOrder[]
  offers  Offer[]

  @@index([tenantId])
}

model AthleteRate {
  id        String @id @default(cuid())
  tenantId  String
  athleteId String
  jobId     String
  /// cents
  amount    Int
  version   Int    @default(1)

  athlete Athlete @relation(fields: [athleteId], references: [id])
  job     NilJob  @relation(fields: [jobId], references: [id])

  @@unique([athleteId, jobId, version])
  @@index([tenantId])
}

/// §7 — Test Drive … Season Partner.
///
/// `lineItems` is what P0-PMO-10 §2 said a package could not be sold without:
/// job codes and counts, e.g. [{ "jobCode": "SX-02", "quantityPerAthlete": 1 }].
/// Athlete count is a RANGE because the §7 packages are ranges, and the range
/// is precisely where the margin swing lived before the pricing decision.
model SponsorPackage {
  id              String  @id @default(cuid())
  tenantId        String
  code            String
  name            String
  priceLow        Int
  priceHigh       Int
  athleteCountMin Int
  athleteCountMax Int
  lineItems       Json
  /// Non-NIL inventory sold alongside the jobs, e.g. an iMC/BTG feature.
  includes        Json?
  exclusivity     Boolean @default(false)
  durationWeeks   Int?
  active          Boolean @default(true)

  briefs CampaignBrief[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Sponsor {
  id       String @id @default(cuid())
  tenantId String
  name     String

  // Zoho (§18 — Accounts are bi-directional)
  zohoAccountId  String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  /// When the last sync in either direction succeeded. With `updatedAt` this
  /// is the concurrent-change test (field-mapping §8.1 step 3).
  lastSyncAt     DateTime?
  updatedAt      DateTime    @default(now()) @updatedAt

  /// SponsorX NEXT (P9-BE-13, spec §5.1) — SCHOOL | SPONSORX | STUDENT_ORIGINATED.
  /// Who holds the customer relationship. Set when the account is first sold
  /// and never moved: students own attribution, not customers.
  ownership         String   @default("SPONSORX")
  schoolPropertyId  String?
  /// The student currently working this account. NOT ownership and NOT
  /// attribution — reassigning it changes nothing about who originated a sale.
  assignedStudentId String?
  /// Phase 2 (2S2-BE-02) — the brand categories this sponsor sells in
  /// (BRAND_CATEGORIES). Set by BTG. Every restriction and exclusivity check
  /// asks against these; a sponsor with none cannot buy in the marketplace.
  categories        String[]

  briefs    CampaignBrief[]
  campaigns Campaign[]
  contacts  SponsorContact[]

  @@index([tenantId])
}

/// The people at a sponsor — P4-BE-01, §18, §20.
///
/// Separate from `User`: a sponsor contact is someone BTG sells to and Zoho
/// knows about, and most of them never sign in. Folding them into `User`
/// would mean every Zoho Contact arriving as a login-capable account.
model SponsorContact {
  id        String  @id @default(cuid())
  tenantId  String
  sponsorId String
  name      String
  email     String
  phone     String?
  /// Job title as the sponsor gives it. Free text — normalising it would be
  /// inventing a taxonomy nobody asked for.
  title     String?
  /// Who to write to by default. Not unique at the database: a sponsor
  /// mid-handover legitimately has two for a while, and refusing that would
  /// block a sync Zoho has already accepted.
  isPrimary Boolean @default(false)

  // Zoho (§18 — Contacts are bi-directional)
  zohoContactId  String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  @@index([tenantId, sponsorId])
  @@index([tenantId, email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Brief → matching → campaign
// ─────────────────────────────────────────────────────────────────────────────

/// §13 step 2.
model CampaignBrief {
  id            String     @id @default(cuid())
  tenantId      String
  sponsorId     String
  objective     String
  /// cents
  budget        Int
  packageId     String?
  /// SponsorX NEXT (P9-BE-07): the student code the sponsor arrived with
  /// (/s/[code]). A sale on this brief is attributed to that student.
  studentCodeId String?
  startDate     DateTime
  endDate       DateTime
  sports        String[]
  /// US state codes targeted by the brief.
  stateCodes    String[]
  /// Conflict-check input — §26.
  categories    String[]
  state         BriefState @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  // Zoho (§18 rows 4–5). The Deal is created when the brief qualifies, before
  // any Campaign exists, so the brief holds it; the campaign copies it on
  // creation and owns it from then on (field-mapping §4.1, S-3, S-8).
  zohoDealId     String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?

  sponsor     Sponsor         @relation(fields: [sponsorId], references: [id])
  package     SponsorPackage? @relation(fields: [packageId], references: [id])
  studentCode StudentCode?    @relation(fields: [studentCodeId], references: [id])
  campaign    Campaign?

  @@index([tenantId, state])
}

model Campaign {
  id        String        @id @default(cuid())
  tenantId  String
  sponsorId String
  briefId   String?       @unique
  name      String
  /// cents
  budget    Int
  startDate DateTime
  endDate   DateTime
  state     CampaignState @default(DRAFT)

  // Zoho (§18 — Deals are bi-directional)
  zohoDealId        String?     @unique
  lastSyncOrigin    SyncOrigin?
  lastSyncHash      String?
  lastSyncAt        DateTime?
  /// §18 row 9 — the renewal is a second Deal, pushed once, never read back.
  zohoRenewalDealId String?     @unique
  updatedAt         DateTime    @default(now()) @updatedAt

  sponsor       Sponsor           @relation(fields: [sponsorId], references: [id])
  brief         CampaignBrief?    @relation(fields: [briefId], references: [id])
  invites       CampaignInvite[]
  orders        CampaignOrder[]
  offers        Offer[]
  rewards       Reward[]
  invoices      CampaignInvoice[]
  /// SponsorX NEXT — the ad positions this campaign bought (P9-BE-03).
  adSlots       AdSlot[]
  /// Edition content sponsored by this campaign — only with a commercial
  /// grant (P9-BE-10).
  editionAssets EditionAsset[]
  /// Server-rendered sponsor reports (2S7-BE-02).
  reportFiles   ReportFile[]

  @@index([tenantId, state])
}

/// §21 — INVITED → VIEWED → ACCEPTED / DECLINED / EXPIRED.
model CampaignInvite {
  id          String      @id @default(cuid())
  tenantId    String
  campaignId  String
  athleteId   String
  jobId       String
  /// cents
  offered     Int
  state       InviteState @default(INVITED)
  sentAt      DateTime    @default(now())
  viewedAt    DateTime?
  respondedAt DateTime?
  expiresAt   DateTime

  campaign Campaign @relation(fields: [campaignId], references: [id])
  athlete  Athlete  @relation(fields: [athleteId], references: [id])
  job      NilJob   @relation(fields: [jobId], references: [id])

  /// NO full @@unique here on purpose. "One invite per athlete per job, ever"
  /// would forbid re-inviting an athlete whose previous invitation EXPIRED or
  /// was DECLINED, which is ordinary business. The rule actually wanted is one
  /// OPEN invite at a time, and that needs a partial unique index — see
  /// prisma/sql/invite_one_open.sql (P2-BE-03).
  @@index([tenantId, state, expiresAt])
  @@index([campaignId, athleteId, jobId])
}

/// The commercial record, one per athlete per job.
model CampaignOrder {
  id           String   @id @default(cuid())
  tenantId     String
  campaignId   String
  athleteId    String
  jobId        String
  /// cents — the agreed athlete compensation, not the sponsor price.
  compensation Int
  /// cents — what the sponsor pays for THIS line.
  ///
  /// Added 2026-09-22 for P3-BE-12. Its acceptance is "refuse a line whose
  /// sponsor price is below athlete cost x 1.4", and there was no per-line
  /// sponsor price to refuse against — only the campaign budget, which lets a
  /// campaign with room hide one underwater line behind several cheap ones.
  /// The 1.4x rule itself was settled by P0-PMO-13; this is the column it
  /// needed.
  sellPrice    Int
  usageRights  String
  exclusivity  String?
  dueDate      DateTime

  /// What we expected this line to reach, FROZEN AT CREATION — P7-DATA-03.
  ///
  /// Frozen for the same reason `compensation` and `sellPrice` are: the
  /// projection comes from the athlete's own follower and view figures, which
  /// move. Recomputing later answers "what would we project today", and the
  /// question worth learning from is "what did we think this was worth when
  /// we sold it". A derived number is normally not stored in this codebase
  /// (see the metric rollup); this one is an exception because it is a
  /// historical fact about a sale rather than an aggregate over rows.
  ///
  /// Null where the athlete had no usable audience figure. An absent
  /// projection is honest; a zero would be a claim.
  projectedImpressions Int?
  /// cents per thousand projected impressions. Derived from `sellPrice` and
  /// `projectedImpressions`, stored alongside them so the arithmetic that
  /// produced it can be checked later.
  impliedCpm           Int?
  /// The provenance of the PROJECTION — usually SELF_REPORTED in Phase 1,
  /// because that is what an athlete's follower count is. Carried so no
  /// report can present an implied CPM as though it rested on verified
  /// reach (§22).
  projectionSource     MetricSource?
  state                OrderState    @default(DRAFT)
  acceptedAt           DateTime?
  acceptanceId         String?       @unique

  campaign     Campaign             @relation(fields: [campaignId], references: [id])
  athlete      Athlete              @relation(fields: [athleteId], references: [id])
  job          NilJob               @relation(fields: [jobId], references: [id])
  acceptance   AgreementAcceptance? @relation(fields: [acceptanceId], references: [id])
  deliverables Deliverable[]
  earning      Earning?
  offer        Offer?

  @@unique([campaignId, athleteId, jobId])
  @@index([tenantId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery
// ─────────────────────────────────────────────────────────────────────────────

model Deliverable {
  id           String           @id @default(cuid())
  tenantId     String
  orderId      String
  title        String
  dueDate      DateTime
  state        DeliverableState @default(NOT_STARTED)
  publishedUrl String?
  publishedAt  DateTime?

  order   CampaignOrder   @relation(fields: [orderId], references: [id])
  assets  CreativeAsset[]
  link    TrackingLink?
  metrics MetricDaily[]

  @@index([tenantId, state, dueDate])
}

model CreativeAsset {
  id            String   @id @default(cuid())
  tenantId      String
  deliverableId String
  version       Int
  /// Private bucket; signed-URL access only (§11). Never a public URL.
  r2Key         String
  /// §12 — pre-derived sizes, since next/image optimization is not adopted.
  derivatives   Json?
  uploadedBy    String
  uploadedAt    DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@unique([deliverableId, version])
  @@index([tenantId])
}

model MetricDaily {
  id            String       @id @default(cuid())
  tenantId      String
  deliverableId String
  day           DateTime     @db.Date
  views         Int          @default(0)
  engagements   Int          @default(0)
  source        MetricSource
  enteredBy     String?

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  /// Same day, same deliverable, different source is a DIFFERENT row — a
  /// manually verified figure never silently overwrites an API one.
  @@unique([deliverableId, day, source])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// The two funnels — kept apart on purpose
//
// A tracking link measures AN ATHLETE'S DELIVERABLE. A reward token measures
// A FAN'S JOURNEY. V1 collapsed them and wrote a TrackingLink id into a field
// that foreign-keys RewardToken; that bug is the reason these are separate.
// ─────────────────────────────────────────────────────────────────────────────

model TrackingLink {
  id             String @id @default(cuid())
  tenantId       String
  /// Short and opaque. Never the record id.
  code           String @unique
  deliverableId  String @unique
  destinationUrl String

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  events      LinkEvent[]

  @@index([tenantId])
}

/// Athlete-attribution clicks. Geo resolved in a worker job (§06), never from
/// request headers — those are host-specific and Railway does not send them.
model LinkEvent {
  id       String   @id @default(cuid())
  tenantId String
  linkId   String
  at       DateTime @default(now())
  city     String?
  region   String?

  link TrackingLink @relation(fields: [linkId], references: [id])

  @@index([tenantId, linkId, at])
}

model Reward {
  id         String      @id @default(cuid())
  tenantId   String
  campaignId String
  offerText  String
  singleUse  Boolean     @default(true)
  expiresAt  DateTime
  terms      String
  state      RewardState @default(DRAFT)

  campaign Campaign      @relation(fields: [campaignId], references: [id])
  tokens   RewardToken[]

  @@index([tenantId, state])
}

model RewardToken {
  id        String  @id @default(cuid())
  tenantId  String
  rewardId  String
  /// Per-athlete attribution — which athlete's QR produced this journey.
  athleteId String?
  /// Opaque, never the record id.
  token     String  @unique
  /// R2 object in the private bucket.
  qrKey     String?

  reward  Reward        @relation(fields: [rewardId], references: [id])
  athlete Athlete?      @relation(fields: [athleteId], references: [id])
  events  RewardEvent[]

  @@index([tenantId])
}

/// One row per event. The single-use rule is enforced by a partial unique
/// index on (tokenId) WHERE type = 'REDEEM' — P2-BE-03, not this file. An
/// application-level "already redeemed?" check loses the race; an index does
/// not.
model RewardEvent {
  id       String          @id @default(cuid())
  tenantId String
  tokenId  String
  type     RewardEventType
  at       DateTime        @default(now())
  city     String?
  region   String?
  /// The ONLY fan PII this system holds, and it is optional — §16's page has
  /// no login and asking for an address as a condition of claiming would be a
  /// barrier at a stall. It may only be set together with the three consent
  /// columns below (P6-SEC-01); `recordClaim` refuses otherwise.
  fanEmail String?

  /// Consent, captured at the moment of the claim — P6-SEC-01, §26.
  ///
  /// THE VERSION IS THE POINT. "They consented" is not a defensible record
  /// three months later when the wording has been edited twice; "they
  /// consented to version 2026-09-01 at this timestamp" is. The version
  /// string is the identity of the text that was actually on screen.
  ///
  /// All three are null where no email was given — there is nothing to
  /// consent to holding.
  consentVersion     String?
  consentAt          DateTime?
  /// What the fan was told the address would be used for, as a short code
  /// (e.g. "reward-delivery"). Consent is scoped: agreeing to be sent a
  /// voucher is not agreeing to marketing, and a single boolean would lose
  /// that distinction the first time someone exported the list.
  consentPurpose     String?
  /// When the fan withdrew that consent (P6-SEC-03) — the one-tap unsubscribe
  /// link in every fan email. Recorded on THIS row, beside the consent it
  /// withdraws, so the record reads "agreed to 2026-09-01 at T1, withdrew at
  /// T2" in one place. Every query that contacts a fan filters on it being
  /// null (`CONTACTABLE` in domain/fan-consent.ts).
  consentWithdrawnAt DateTime?

  /// The SECOND, separate consent — "the sponsor may contact me about their
  /// offers" (2S6-BE-03). Its own box, unticked by default, its own dated
  /// text version. Only a claim carrying it (and not withdrawn) ever exposes
  /// the address to the sponsor, and only through domain/fan-leads.ts. The
  /// one-tap unsubscribe withdraws it together with the delivery consent.
  sponsorContactVersion     String?
  sponsorContactAt          DateTime?
  sponsorContactWithdrawnAt DateTime?
  /// The Zoho Lead this claim became (2S6-INT-03), once pushed.
  zohoLeadId                String?   @unique

  token RewardToken @relation(fields: [tokenId], references: [id])

  @@index([tenantId, type, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Money, agreements, plumbing
// ─────────────────────────────────────────────────────────────────────────────

/// Phase 1 tracks earnings STATUS only. No tax ID, no bank details, ever —
/// §26 and Addendum A6. `reference` holds a Zoho or bank reference, which is
/// a pointer, not a credential.
model Earning {
  id         String       @id @default(cuid())
  tenantId   String
  athleteId  String
  orderId    String       @unique
  /// cents
  gross      Int
  adjustment Int          @default(0)
  state      EarningState @default(PENDING)
  taxYear    Int
  paidAt     DateTime?
  reference  String?

  order   CampaignOrder @relation(fields: [orderId], references: [id])
  athlete Athlete       @relation(fields: [athleteId], references: [id])

  /// Year-end reporting rollup.
  @@index([athleteId, taxYear])
  @@index([tenantId, state])
}

/// A versioned agreement template. `bodyHash` is the sha256 of the exact text
/// shown, so a later wording change can never be mistaken for what somebody
/// actually agreed to.
model Agreement {
  id          String   @id @default(cuid())
  tenantId    String
  /// COLLAB | CAMPAIGN_ORDER | GUARDIAN | RELEASE, and for SponsorX NEXT
  /// (P9-BE-11, spec §5.4 — three agreements, not one): FEATURE | PROFILE |
  /// COMMERCIAL. Data, not schema.
  kind        String
  version     Int
  bodyHash    String
  effectiveAt DateTime

  acceptances AgreementAcceptance[]

  @@unique([tenantId, kind, version])
}

model AgreementAcceptance {
  id          String   @id @default(cuid())
  tenantId    String
  agreementId String
  /// SponsorX NEXT (P9-BE-11, spec §6.2) — TYPED SUBJECTS. Exactly one of
  /// userId / athleteId / studentId is set (CHECK in migration
  /// 20260925160000): a featured athlete has no login and a guardian has no
  /// account, so consent must be recordable for a subject with no User.
  userId      String?
  athleteId   String?
  studentId   String?
  /// Copied at accept time, not read back through the template.
  bodyHash    String
  ip          String
  userAgent   String
  acceptedAt  DateTime @default(now())
  /// Set when the athlete is a minor — §4. UNCHANGED meaning: the guardian
  /// who authorised on behalf of a minor subject.
  guardianId  String?

  agreement Agreement      @relation(fields: [agreementId], references: [id])
  user      User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  athlete   Athlete?       @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  student   Student?       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  order     CampaignOrder?
  rights    ContentRight[]

  @@index([tenantId, agreementId])
}

/// The transactional outbox (§05). A job is written in the same transaction as
/// the work that causes it, and drained separately — so Zoho being down never
/// touches a request path.
model OutboxJob {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  payload      Json
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([tenantId])
}

/// Invoices and payment status, MIRRORED from Zoho — P7-BE-04, §18.
///
/// SPONSORX IS NOT THE INVOICE SYSTEM OF RECORD, and this model is shaped to
/// make that hard to forget. Every row is a copy of something Zoho Books owns:
/// there is no line-item table, no tax field, no totalling logic and no way to
/// issue or amend an invoice here. `zohoInvoiceId` is unique because the Zoho
/// record is the identity — this table has no identity of its own to defend.
///
/// It exists so that "has this campaign been paid?" can be answered without a
/// request to Zoho on a page load (§18 keeps Zoho off every request path).
/// When the two disagree, Zoho is right and the next sync corrects this.
model CampaignInvoice {
  id         String @id @default(cuid())
  tenantId   String
  campaignId String

  /// The Zoho Books invoice. Unique: it is the real identity of this row.
  zohoInvoiceId String  @unique
  /// Human-facing number as Zoho issued it, e.g. "INV-000042".
  number        String?
  /// Zoho's own status string, copied verbatim rather than re-modelled —
  /// draft | sent | overdue | paid | void. Mapping it onto an enum of ours
  /// would mean maintaining a translation that silently drops any status
  /// Zoho adds later.
  status        String
  /// cents
  amount        Int
  currency      String  @default("USD")

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  /// §18 loop prevention — which side wrote last, and a hash of what was
  /// written, so an echo of our own update is recognised and dropped.
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  syncedAt       DateTime    @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([tenantId, status])
  @@index([campaignId])
}

/// §20 — inbound Zoho attempts, recorded whether or not they were accepted.
/// tenantId is nullable because a webhook is logged before it is known which
/// tenant it resolves to; recording the rejected ones is the point.
model WebhookDelivery {
  id          String   @id @default(cuid())
  tenantId    String?
  /// "zoho"
  source      String
  externalId  String?
  signatureOk Boolean
  payload     Json
  /// RECEIVED | APPLIED | REJECTED | FAILED
  status      String
  error       String?
  receivedAt  DateTime @default(now())

  @@index([source, receivedAt])
}

/// An inbound sponsor enquiry — §18 row 3, P8-INT-06, field-mapping §7.3/S-2.
/// Pushed one-way to Zoho Leads; qualification happens in the CRM. A sponsor
/// enquiry, not a fan: fan-consent lead capture is Phase 2 (2S6-INT-03).
model Inquiry {
  id          String   @id @default(cuid())
  tenantId    String
  companyName String?
  firstName   String?
  lastName    String
  email       String
  phone       String?
  message     String?
  /// "web-form" | "outbound" | "event"
  source      String
  zohoLeadId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId, createdAt])
}

/// A CRM task SponsorX originates — §18 row 7, field-mapping §7.5/S-4.
/// Follow-ups, approvals and renewals. Tasks staff create in Zoho stay there.
/// Deal and contact links are held as OUR ids and resolved to Zoho ids at
/// push time, because the task is usually created before its deal reaches
/// Zoho — a stored Zoho id would be null exactly when it is needed.
model SyncTask {
  id             String      @id @default(cuid())
  tenantId       String
  /// FOLLOW_UP | APPROVAL | RENEWAL
  kind           String
  subject        String
  body           String?
  dueDate        DateTime
  completedAt    DateTime?
  /// → User.zohoUserId as the CRM Owner.
  assigneeUserId String?
  briefId        String?
  campaignId     String?
  zohoTaskId     String?     @unique
  lastSyncOrigin SyncOrigin?
  lastSyncHash   String?
  lastSyncAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  /// `<kind>:<brief or campaign id>`, e.g. `approval:c_123`. One task per
  /// event: a retried transition must not raise a second CRM task.
  dedupeKey String @unique

  @@index([tenantId, dueDate])
}

/// The nightly drift report — P8-INT-05, field-mapping §8.3. One row per
/// module per run. Reported, never auto-repaired: repairing a mapping this
/// new would paper over the bug that caused the drift.
model ZohoReconciliation {
  id                String   @id @default(cuid())
  tenantId          String
  /// Accounts | Contacts | Deals | Tasks
  module            String
  ranAt             DateTime @default(now())
  checked           Int
  /// Our ids with no Zoho record — a lost push.
  missingInZoho     Json
  /// Zoho ids carrying a SponsorX_ID we do not recognise.
  unknownInSponsorX Json
  /// Present on both sides, shared fields disagree — a missed webhook.
  diverged          Json

  @@index([tenantId, ranAt])
}

/// Sent-email ledger (P3-INT-01). Not a copy of the message — the key, the
/// template and the recipient only, because §26 is clear that personal data
/// should not accumulate in places nobody thinks to look.
///
/// Its whole job is idempotency: outbox delivery is at-least-once and pg-boss
/// retries, so the handler claims a key here before sending and refuses a key
/// it has already claimed. Without it a redelivered job emails a person twice,
/// and "your application was rejected" twice is its own small harm.
model EmailSendLog {
  idempotencyKey String   @id
  tenantId       String
  template       String
  to             String
  sentAt         DateTime @default(now())

  @@index([tenantId, sentAt])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, at])
}

// ─────────────────────────────────────────────────────────────────────────────
// SponsorX NEXT — publications, editions and their inventory (Stage 9 Batch A:
// P9-BE-02, -03, -06, -12). Spec v2.0 §5.2, §5.7, §6.4. The Stage 9 schema
// gate (P9-PMO-03) was lifted by the programme owner on 2026-09-25.
// ─────────────────────────────────────────────────────────────────────────────

/// The masthead. Per school (`propertyId`), or regional with `propertyId`
/// null for the DMV edition (§5.2).
model Publication {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String?
  name       String
  createdAt  DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  editions Edition[]

  @@index([tenantId])
}

/// Fall / Winter / Spring / Year-End. The three V3 §3 production conditions
/// are explicit columns, not a computed opinion.
model Edition {
  id             String       @id @default(cuid())
  tenantId       String
  publicationId  String
  label          String
  /// Ad deadline — no slot sells on or after it (database-enforced).
  closeDate      DateTime
  publishTarget  DateTime
  printDate      DateTime?
  pageCount      Int?
  contentReady   Boolean      @default(false)
  rightsCleared  Boolean      @default(false)
  revenueMet     Boolean      @default(false)
  /// cents — the minimum viable edition threshold
  thresholdCents Int
  state          EditionState @default(PLANNING)

  publication   Publication            @relation(fields: [publicationId], references: [id])
  slots         AdSlot[]
  splits        RevenueSplit[]
  events        EditionEvent[]
  assets        EditionAsset[]
  contributions ContentContribution[]
  schoolPools   SchoolPoolAllocation[]

  @@index([tenantId, state])
}

/// P9-BE-02. V1 is a free digital edition; print is an optional layer.
enum EditionState {
  PLANNING
  SELLING
  CLOSED
  IN_PRODUCTION
  PUBLISHED_DIGITAL
  PRINTED
  DISTRIBUTED
  CANCELLED
}

/// The inventory ledger — one row per sellable position (P9-BE-03). It points
/// at the Campaign, not a CampaignOrder: an order needs an athlete and a job,
/// and an ad has neither. Selling twice, selling after close, and a second
/// back cover are all refused by Postgres (migration 20260925120000).
model AdSlot {
  id         String     @id @default(cuid())
  tenantId   String
  editionId  String
  /// "P04-QTR" — the position on the flatplan.
  slotCode   String
  kind       AdSlotKind
  /// cents — rack price
  priceCents Int
  /// Positions this row represents. Always 1: several identical positions
  /// are several rows, so each can be sold on its own (CHECK in migration).
  quantity   Int        @default(1)
  campaignId String?
  /// cents — frozen at sale; may differ from rack (an add-on sold with it).
  soldCents  Int?
  soldAt     DateTime?

  edition  Edition   @relation(fields: [editionId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@unique([editionId, slotCode])
  @@index([tenantId, editionId])
  @@index([campaignId])
}

/// Matches the AD_SLOT / PRESENTING codes in the NEXT packages' `includes`.
enum AdSlotKind {
  QUARTER
  HALF
  FULL
  BACK_COVER
  PRESENTING
}

/// P9-BE-06, §5.7. Attached to the edition. NOT Earning — Earning is athlete
/// NIL pay that finance reconciles payouts from, and schools and pools must
/// never land in it.
model RevenueSplit {
  id          String         @id @default(cuid())
  tenantId    String
  editionId   String
  payeeKind   SplitPayeeKind
  /// basis points of the edition's sold revenue; the four sum to 10,000
  bps         Int
  /// cents — computed at close, never typed in
  amountCents Int
  computedAt  DateTime       @default(now())

  edition Edition @relation(fields: [editionId], references: [id])

  @@unique([editionId, payeeKind])
  @@index([tenantId])
}

enum SplitPayeeKind {
  SPONSORX
  SCHOOL
  STUDENT_POOL
  EDITORIAL_FUND
}

/// P9-BE-12, §6.4. Its own stream — NOT RewardEventType, which is a fan's
/// journey through a reward token. Aggregate-only: no fan identity here.
model EditionEvent {
  id         String         @id @default(cuid())
  tenantId   String
  editionId  String
  /// AD_SLOT | ARTICLE | ATHLETE_PROFILE
  targetKind String
  targetRef  String
  type       EngagementType
  at         DateTime       @default(now())
  city       String?
  region     String?

  edition Edition @relation(fields: [editionId], references: [id])

  @@index([tenantId, editionId, type, at])
  @@index([targetKind, targetRef])
}

/// Print and digital acquisition stay distinct — principle 8. QR_SCAN is
/// print; the rest are digital. Pooling them makes the first sponsor report
/// say something untrue.
enum EngagementType {
  QR_SCAN
  LINK_CLICK
  PROFILE_VIEW
  CAMPAIGN_VIEW
  CTA_CLICK
}

// ─────────────────────────────────────────────────────────────────────────────
// SponsorX NEXT — students (Stage 9 Batch B: P9-BE-04, -05, -07, -13, -15,
// P9-SEC-01). Spec v2.0 §5.1, §5.5, §5.6, §6.3, §7.
// ─────────────────────────────────────────────────────────────────────────────

/// A student correspondent (P9-BE-04). NOT an Athlete: no sport, no tier, no
/// rate card, and compensation that is deliberately not cash (§5.5). An
/// athlete correspondent is both, which is why `athleteId` is here and not a
/// nullable half of Athlete.
model Student {
  id            String       @id @default(cuid())
  tenantId      String
  /// The school.
  propertyId    String
  athleteId     String?      @unique
  guardianId    String?
  legalName     String
  displayName   String
  /// Optional on purpose — V3 §2: school email must not be a hard requirement.
  email         String?
  gradYear      Int?
  /// Minor status, on the athlete's rule: a date, or a band where no date is
  /// given (§11). The only age data the programme needs (P9-SEC-01).
  birthDate     DateTime?
  ageBand       String?
  /// EDITOR | WRITER | PHOTOGRAPHER | VIDEO | DESIGNER | SALES | CORRESPONDENT
  masthead      String[]
  state         StudentState @default(DRAFT)
  reviewerNotes String?
  /// Graduated, transferred or withdrew. Access ends; attribution does not.
  leftAt        DateTime?
  createdAt     DateTime     @default(now())

  property      Property              @relation(fields: [propertyId], references: [id])
  athlete       Athlete?              @relation(fields: [athleteId], references: [id])
  guardian      Guardian?             @relation(fields: [guardianId], references: [id])
  code          StudentCode?
  attributions  SalesAttribution[]
  points        StudentPointAccrual[]
  prospects     StudentProspect[]
  consents      AgreementAcceptance[]
  contributions ContentContribution[]

  @@index([tenantId, propertyId, state])
}

/// Mirrors AthleteState — a student application is reviewed by an advisor
/// exactly as an athlete's is by a network manager — plus INACTIVE, V3 §1's
/// "left the programme".
enum StudentState {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// P9-BE-07 — the third attribution namespace. TrackingLink measures an
/// athlete's deliverable and RewardToken a fan's journey; a StudentCode is a
/// PERSON's, across every sale they originate. Neither of the other two is
/// relaxed to fit it.
model StudentCode {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String   @unique
  /// What /s/[code] resolves. Unguessable, like a reward token.
  code      String   @unique
  createdAt DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id])
  briefs  CampaignBrief[]
}

/// P9-BE-13, §5.1, §6.3 — NEVER UPDATED, NEVER DELETED (trigger in migration
/// 20260925140000). One row per originated sale. A student's portfolio
/// depends on it, including after they graduate.
model SalesAttribution {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  sponsorId    String
  campaignId   String?
  editionId    String?
  /// cents, at close
  value        Int
  originatedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([tenantId, studentId])
  @@index([sponsorId])
}

/// P9-BE-15, §5.5 — accruals only. NO cents column, NO EarningState, NO
/// relation to Earning: if points and money shared a table, an athlete
/// payout reconciliation would start returning minors' scholarship balances.
/// Redemption is absent by design — its own gated task (§14 gate 2).
model StudentPointAccrual {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  /// ARTICLE 50 | INTERVIEW 25 | PHOTO 25 | APPOINTMENT 25 | SALES_500 100 | VIEWS_BONUS
  reason    String
  points    Int
  editionId String?
  accruedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId, studentId])
}

/// A business a student has brought to SponsorX (P9-BE-13, §5.6 Sponsor
/// Acceptance Check). Rejection carries a reason code, notifies the student,
/// and costs them no sales credit.
model StudentProspect {
  id                 String        @id @default(cuid())
  tenantId           String
  studentId          String
  businessName       String
  /// A brand category (brand-categories.ts).
  category           String
  state              ProspectState @default(SUBMITTED)
  reasonCode         String?
  /// Open categories offered when the refusal was a category exclusivity.
  redirectCategories String[]
  decidedAt          DateTime?
  createdAt          DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId, studentId])
}

enum ProspectState {
  SUBMITTED
  ACCEPTED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// SponsorX NEXT — rights, featured athletes, the DMV pool (Stage 9 Batch C:
// P9-BE-10, -11, -14). Spec v2.0 §5.3, §5.4, §5.7, §6.1, §6.2.
// ─────────────────────────────────────────────────────────────────────────────

/// A piece of edition content (P9-BE-10) — an article, photo set, interview,
/// video or ad creative. NOT CreativeAsset: that row belongs to an athlete's
/// Deliverable (deliverableId is required), and a student's article is not a
/// deliverable. Relaxing it would repeat the scar TrackingLink carries.
model EditionAsset {
  id         String   @id @default(cuid())
  tenantId   String
  editionId  String
  /// ARTICLE | PHOTO | PHOTO_PACKAGE | INTERVIEW | VIDEO | AD_CREATIVE
  kind       String
  title      String
  /// STUDENT | ATHLETE | BTG | THIRD_PARTY — who made it
  sourceKind String
  studentId  String?
  athleteId  String?
  /// Private bucket key, when a file exists.
  r2Key      String?
  /// Set when a sponsor's campaign uses this asset — refused without a
  /// ContentRight granting commercial reuse.
  campaignId String?
  createdAt  DateTime @default(now())

  edition  Edition        @relation(fields: [editionId], references: [id])
  campaign Campaign?      @relation(fields: [campaignId], references: [id])
  rights   ContentRight[]

  @@index([tenantId, editionId])
}

/// ONE rights ledger, three population paths (spec §6.1): student consent,
/// athlete / guardian consent, and a negotiated BTG or third-party licence.
/// The publication gate asks it one question, in one query.
model ContentRight {
  id          String @id @default(cuid())
  tenantId    String
  assetId     String
  /// STUDENT | ATHLETE | GUARDIAN | BTG | THIRD_PARTY
  grantorKind String
  grantorRef  String

  mayPublishDigital    Boolean @default(false)
  mayPublishPrint      Boolean @default(false)
  mayPromote           Boolean @default(false)
  /// V3 §6 — BTG content defaults FALSE. Editorial use is not a licence to
  /// resell journalism inside a sponsor's campaign.
  mayReuseCommercially Boolean @default(false)

  territory   String?
  startsAt    DateTime
  endsAt      DateTime?
  attribution String?

  /// Consent-based grants point at the acceptance; negotiated licences at a
  /// contract reference. Exactly one is set (CHECK in migration).
  acceptanceId String?
  licenseRef   String?
  createdAt    DateTime @default(now())

  asset      EditionAsset         @relation(fields: [assetId], references: [id])
  acceptance AgreementAcceptance? @relation(fields: [acceptanceId], references: [id])

  @@index([tenantId, assetId])
}

/// A school's roster — what a claim is matched against (P9-BE-11). SIMULATED
/// for the pilot: the real roster is open gate 1 (spec §14 — who supplies it,
/// and a school sharing a list of minors is its own data question). Name and
/// graduation year only: the least a match needs.
model RosterEntry {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  legalName  String
  gradYear   Int?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@index([tenantId, propertyId])
}

/// "That's me" — the athlete's claim on a FEATURED profile (P9-BE-11). The
/// first of the three assertions; the school (roster + advisor) verifies it,
/// and a guardian authorises a minor's commercial activation.
model AthleteClaim {
  id            String     @id @default(cuid())
  tenantId      String
  athleteId     String
  claimantName  String
  claimantEmail String
  birthDate     DateTime?
  ageBand       String?
  rosterMatched Boolean    @default(false)
  state         ClaimState @default(SUBMITTED)
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime   @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([tenantId, athleteId])
}

enum ClaimState {
  SUBMITTED
  VERIFIED
  REJECTED
}

/// P9-BE-14, §5.7 — content a school's student contributed to an edition,
/// in units (FEATURE 5 · PHOTO_PACKAGE 3 · INTERVIEW 3 · VIDEO 5). Distinct
/// from sales credit, which is SalesAttribution.
model ContentContribution {
  id         String   @id @default(cuid())
  tenantId   String
  editionId  String
  studentId  String
  /// The contributing school — the student's, at the time.
  propertyId String
  kind       String
  units      Int
  createdAt  DateTime @default(now())

  edition Edition @relation(fields: [editionId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([tenantId, editionId])
}

/// The regional edition's school pools, resolved by formula (P9-BE-14):
/// SALES by attributed sales, CONTENT by units ÷ total units. Computed when
/// the edition publishes, never typed in.
model SchoolPoolAllocation {
  id          String     @id @default(cuid())
  tenantId    String
  editionId   String
  propertyId  String
  pool        SchoolPool
  amountCents Int
  computedAt  DateTime   @default(now())

  edition Edition @relation(fields: [editionId], references: [id])

  @@unique([editionId, propertyId, pool])
  @@index([tenantId])
}

enum SchoolPool {
  SALES
  CONTENT
}

/// A sponsor report rendered unattended on the worker (2S7-BE-02) — for when
/// no one opens a browser, e.g. delivery to a renewal signer who never logs
/// in. The file is in the PRIVATE bucket; this row is how it is found. Read
/// through the `sponsorReport` matrix resource.
model ReportFile {
  id          String   @id @default(cuid())
  tenantId    String
  campaignId  String
  /// Private bucket key: reports/<campaignId>/<renderedAt>.pdf
  r2Key       String   @unique
  bytes       Int
  /// COMPLETED (the renewal hand-off) or REQUESTED (someone asked)
  trigger     String
  requestedBy String?
  renderedAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([tenantId, campaignId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 · Sprint 1 — external property onboarding (2S1-BE-01, 2S1-BE-03).
// State machine: documentation/SponsorX-Phase2-State-Machines.md §1.
// ─────────────────────────────────────────────────────────────────────────────

/// An outside organisation's application to sell on the marketplace. Filled
/// in step by step through the public API with a resume token — no login
/// exists yet. Holds NO tax id and NO bank details: payout and tax details
/// are collected by the payment provider (2S0-PMO-03, 2S5-INT-03), and this
/// row records only that the applicant acknowledged that step.
model PropertyOnboarding {
  id                   String          @id @default(cuid())
  tenantId             String
  state                OnboardingState @default(DRAFT)
  /// TEAM | SCHOOL | EVENT | MEDIA | VIRTUAL — becomes Property.kind
  orgType              String
  orgName              String
  /// US state (or DC) the organisation operates in — drives required fields.
  stateCode            String?
  /// [{ name, email, phone?, role, primary }]
  contacts             Json            @default("[]")
  /// Type-specific business details, validated per orgType (strict: unknown
  /// keys, and so any tax or bank field, are refused).
  details              Json            @default("{}")
  /// The applicant confirmed payout and tax details go to the payment
  /// provider, not to SponsorX.
  payoutAcknowledgedAt DateTime?
  termsAgreementId     String?
  termsHash            String?
  termsAcceptedAt      DateTime?
  submittedAt          DateTime?
  reviewNotes          String?
  decidedAt            DateTime?
  decidedBy            String?
  /// The Property created on approval.
  propertyId           String?         @unique
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  property  Property?            @relation(fields: [propertyId], references: [id])
  documents OnboardingDocument[]

  @@index([tenantId, state])
}

/// Phase 2 (2S1-BE-02) — a verification document attached to an onboarding:
/// proof of the rights to sell inventory, business registration, identity.
/// The bytes live in the PRIVATE bucket only; this row is the index. The
/// applicant gets an upload grant and never a read; BTG reads through an
/// audited, time-limited link.
model OnboardingDocument {
  id           String    @id @default(cuid())
  tenantId     String
  onboardingId String
  /// RIGHTS_PROOF | BUSINESS_REGISTRATION | IDENTITY | OTHER
  kind         String
  filename     String
  contentType  String
  /// Declared at grant time; replaced by the stored size on confirm.
  bytes        Int
  /// Private bucket key: onboarding/<onboardingId>/<id>-<filename>
  r2Key        String    @unique
  /// Set when the applicant confirms and the object is found in the bucket.
  uploadedAt   DateTime?
  createdAt    DateTime  @default(now())

  onboarding PropertyOnboarding @relation(fields: [onboardingId], references: [id])

  @@index([tenantId, onboardingId])
}

/// Phase 2 (2S6-BE-02) — a user muting one channel for one event type. No
/// row means the default: delivered. The worker reads this at send time.
model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// The event — an email template name, e.g. "invitation.reminder".
  event     String
  /// EMAIL today; the key has room for SMS and push.
  channel   String
  muted     Boolean
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, event, channel])
  @@index([tenantId])
}

enum OnboardingState {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

/**
 * ── Phase 2 Sprint 2–3 · inventory, listings, offers, branding ──────────
 */

/// 2S2-BE-01 / 2S2-BE-04 — something an outside party sells: an athlete's own
/// NIL item, or a team's property inventory (signage, tickets, a camp).
/// Exactly one owner. Priced by the owner, not by BTG.
model InventoryItem {
  id                   String    @id @default(cuid())
  tenantId             String
  /// The athlete who sells it — or null when the team (propertyId) does.
  athleteId            String?
  propertyId           String?
  /// The catalogue kind it corresponds to, when there is one (NilJob.id).
  jobId                String?
  title                String
  description          String?
  /// SOCIAL_POST | VIDEO | APPEARANCE | AUTOGRAPH | CAMP | SIGNAGE | TICKETS | OTHER
  kind                 String
  /// Cents, set by the owner.
  priceCents           Int
  /// How many can be sold; null means unlimited.
  quantity             Int?
  availableFrom        DateTime?
  availableUntil       DateTime?
  /// Brand categories it suits, and the ones it will not be sold to.
  categories           String[]
  restrictedCategories String[]
  /// { minQuantity?, maxQuantity?, bundleOnly? } — strict.
  packageRules         Json      @default("{}")
  active               Boolean   @default(true)
  /// Bumped on every price or quantity change.
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  athlete     Athlete?              @relation(fields: [athleteId], references: [id])
  property    Property?             @relation(fields: [propertyId], references: [id])
  listings    Listing[]
  commitments InventoryCommitment[]
  /// 2S3-BE-02 — a PACKAGE item's contents, and the packages an item is in.
  components  BundleComponent[]     @relation("bundle")
  inBundles   BundleComponent[]     @relation("component")

  @@index([tenantId, athleteId])
  @@index([tenantId, propertyId])
}

enum ListingState {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// 2S3-BE-01 — the public face of an inventory item. Creating inventory and
/// publishing a listing are separate steps so governance sits between them
/// (Phase 2 state machines §2).
model Listing {
  id              String       @id @default(cuid())
  tenantId        String
  /// The verified property whose listing it is.
  propertyId      String
  inventoryItemId String
  title           String
  description     String?
  /// PUBLIC | PRIVATE (offered to invited sponsors only — 2S3-BE-04)
  visibility      String       @default("PUBLIC")
  state           ListingState @default(DRAFT)
  /// When it becomes visible once published; null means at once.
  publishAt       DateTime?
  submittedAt     DateTime?
  reviewNotes     String?
  decidedAt       DateTime?
  decidedBy       String?
  publishedAt     DateTime?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  property  Property      @relation(fields: [propertyId], references: [id])
  item      InventoryItem @relation(fields: [inventoryItemId], references: [id])
  cartLines CartLine[]

  @@index([tenantId, state])
  @@index([inventoryItemId, state])
}

enum OfferState {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// 2S2-BE-03 — a formal offer to an athlete: a commercial instrument, not an
/// invitation. Terms freeze when it is sent; acceptance writes an immutable,
/// hashed snapshot, creates the order and schedules its deliverables.
/// Postgres refuses any change to the terms once sent (prisma/sql/offer_terms_immutable.sql).
model Offer {
  id              String     @id @default(cuid())
  tenantId        String
  campaignId      String
  athleteId       String
  jobId           String
  /// The athlete's inventory item this offer buys, when it buys one.
  inventoryItemId String?
  brief           String
  /// Cents — the athlete's pay; and what the sponsor pays for the line.
  compensation    Int
  sellPrice       Int
  /// [{ title, dueDate }] — each becomes a scheduled Deliverable on acceptance.
  deliverables    Json
  usageRights     String
  exclusivityDays Int?
  /// The disclosures the content must carry, e.g. "#ad", "Paid partnership".
  disclosures     String[]
  expiresAt       DateTime
  state           OfferState @default(DRAFT)
  sentAt          DateTime?
  respondedAt     DateTime?
  /// sha256 of the canonical terms, fixed when sent — what the athlete accepts.
  termsHash       String?
  /// The terms exactly as accepted. Never changes.
  termsSnapshot   Json?
  orderId         String?    @unique
  createdBy       String?
  createdAt       DateTime   @default(now())

  campaign Campaign       @relation(fields: [campaignId], references: [id])
  athlete  Athlete        @relation(fields: [athleteId], references: [id])
  job      NilJob         @relation(fields: [jobId], references: [id])
  order    CampaignOrder? @relation(fields: [orderId], references: [id])

  @@index([tenantId, state])
  @@index([tenantId, athleteId])
}

/// 2S7-BE-01 — a tenant's own look: shown in its portal and on its reports.
/// The logo lives in the PUBLIC bucket (it is shown to anyone who sees the
/// portal); the report embeds it, since a rendered report fetches nothing.
model TenantBranding {
  tenantId     String   @id
  displayName  String?
  /// Public bucket key: branding/<tenantId>/logo-<random>.<png|jpg>
  logoKey      String?
  /// #RRGGBB
  primaryColor String?
  accentColor  String?
  reportFooter String?
  /// Readiness for custom subdomain mapping: the host the tenant wants
  /// (e.g. partners.bowiebulldogs.com). Stored and unique; not yet routed.
  customDomain String?  @unique
  updatedBy    String?
  updatedAt    DateTime @default(now()) @updatedAt
}

/**
 * ── Phase 2 batch 4 · restrictions, commitments, carts ────────────────────
 */

/// 2S2-BE-02 — a brand category an athlete or a team will not be sold to, for
/// a date range (open-ended when either end is null). Extends Phase 1's
/// `Athlete.restrictedCategories`, which still counts as an open-ended
/// PROHIBITED restriction. A team's restriction covers its roster athletes.
model BrandRestriction {
  id            String    @id @default(cuid())
  tenantId      String
  athleteId     String?
  propertyId    String?
  /// A BRAND_CATEGORIES value.
  category      String
  /// PROHIBITED | LEAGUE_RULE | SCHOOL_POLICY | EXCLUSIVITY
  type          String
  startsOn      DateTime?
  endsOn        DateTime?
  reason        String?
  /// Set when an accepted offer's exclusivity wrote this row — contractual,
  /// so the athlete cannot delete it.
  sourceOfferId String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  athlete  Athlete?  @relation(fields: [athleteId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([tenantId, athleteId])
  @@index([tenantId, propertyId])
  @@index([sourceOfferId])
}

/// 2S3-BE-03 — stock that is spoken for: what the availability check counts
/// against quantity and, for exclusive items, against dates. Written by an
/// accepted offer today; reservations (2S4-BE-02) and orders (2S4-BE-03)
/// write here too. Released rows no longer count.
model InventoryCommitment {
  id              String    @id @default(cuid())
  tenantId        String
  inventoryItemId String
  quantity        Int
  startsOn        DateTime
  endsOn          DateTime
  /// OFFER | RESERVATION | ORDER
  source          String
  sourceId        String
  releasedAt      DateTime?
  /// 2S4-BE-02 — a hold stops counting the moment this passes, whether or
  /// not the sweep has run yet. Null for commitments that do not lapse.
  expiresAt       DateTime?
  /// 2S4-BE-05 — an order's stock is HELD while it awaits approval and
  /// CONTRACTED only once BTG (or policy) approves it.
  contracted      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  item InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([source, sourceId, inventoryItemId])
  @@index([inventoryItemId, releasedAt])
}

enum CartState {
  ACTIVE
  EXPIRED
  CHECKED_OUT
}

/// 2S4-BE-01 — a sponsor's shopping session. Lives in the sponsor's tenant;
/// its lines point at listings in the tenants that tenant operates. Holds no
/// stock (reservations do). Expires after a day without activity.
model Cart {
  id        String    @id @default(cuid())
  tenantId  String
  sponsorId String
  createdBy String?
  currency  String    @default("USD")
  state     CartState @default(ACTIVE)
  expiresAt DateTime
  expiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  lines CartLine[]

  @@index([tenantId, sponsorId, state])
  @@index([state, expiresAt])
}

model CartLine {
  id             String   @id @default(cuid())
  tenantId       String
  cartId         String
  listingId      String
  quantity       Int
  startsOn       DateTime
  endsOn         DateTime
  /// The item's price when the line was last checked.
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([cartId, listingId])
  @@index([tenantId])
}

/**
 * ── Phase 2 batch 5 · packages, reservations, marketplace orders ───────
 */

/// 2S3-BE-02 — one item inside a PACKAGE: the package sells as one unit, and
/// each unit of it takes `quantity` of this component.
model BundleComponent {
  id              String @id @default(cuid())
  tenantId        String
  bundleItemId    String
  componentItemId String
  quantity        Int

  bundle    InventoryItem @relation("bundle", fields: [bundleItemId], references: [id])
  component InventoryItem @relation("component", fields: [componentItemId], references: [id])

  @@unique([bundleItemId, componentItemId])
  @@index([tenantId])
}

enum ReservationState {
  HELD
  CONVERTED
  EXPIRED
  RELEASED
}

/// 2S4-BE-02 — a cart's stock, held for 15 minutes (state machines §3). The
/// hold itself is the InventoryCommitment rows it wrote (source RESERVATION),
/// which stop counting at `expiresAt` even before the sweep marks them.
model Reservation {
  id          String           @id @default(cuid())
  tenantId    String
  sponsorId   String
  cartId      String
  state       ReservationState @default(HELD)
  expiresAt   DateTime
  releasedAt  DateTime?
  convertedAt DateTime?
  createdBy   String?
  createdAt   DateTime         @default(now())

  order MarketplaceOrder?

  @@index([tenantId, sponsorId, state])
  @@index([state, expiresAt])
}

enum MarketplaceOrderState {
  PENDING_APPROVAL
  APPROVED
  AWAITING_PAYMENT
  PAID
  IN_DELIVERY
  FULFILLED
  CLOSED
  CANCELLED
  REFUNDED
}

/// 2S4-BE-03 — the commercial order a reservation becomes (state machines
/// §4). Lives in the sponsor's tenant; its lines name the items it buys in
/// the tenants that tenant operates. Its figures are fixed from APPROVED on
/// (prisma/sql/marketplace_order_immutable.sql).
model MarketplaceOrder {
  id               String                @id @default(cuid())
  tenantId         String
  sponsorId        String
  reservationId    String                @unique
  state            MarketplaceOrderState @default(PENDING_APPROVAL)
  currency         String                @default("USD")
  subtotalCents    Int
  feesCents        Int
  totalCents       Int
  /// 2S4-BE-05 — whether policy sends it to BTG, and why.
  requiresApproval Boolean
  approvalReasons  String[]
  decidedAt        DateTime?
  /// A user id, or "system" when policy approved it.
  decidedBy        String?
  decisionNotes    String?
  contractedAt     DateTime?
  createdBy        String?
  /// 2S7-INT-01 — the Deal this order is in Zoho.
  zohoDealId       String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  reservation Reservation            @relation(fields: [reservationId], references: [id])
  lines       MarketplaceOrderLine[]

  @@index([tenantId, sponsorId, state])
  @@index([tenantId, state])
}

model MarketplaceOrderLine {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  listingId       String
  inventoryItemId String
  /// The outside tenant and property the line buys from.
  itemTenantId    String
  propertyId      String
  title           String
  quantity        Int
  startsOn        DateTime
  endsOn          DateTime
  unitPriceCents  Int
  lineTotalCents  Int

  order MarketplaceOrder @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@index([propertyId])
}
