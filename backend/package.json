{
  "name": "@sponsorx/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/combined.mts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "worker": "node --env-file-if-exists=../.env --import tsx worker/index.mts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "lint": "eslint",
    "start:api": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "start:worker": "node --env-file-if-exists=../.env --import tsx worker/index.mts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "3.1132.0",
    "@aws-sdk/s3-request-presigner": "3.1132.0",
    "@clerk/backend": "3.18.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.1.0",
    "ioredis": "5.6.1",
    "maxmind": "5.0.7",
    "pg": "8.23.0",
    "pg-boss": "12.32.0",
    "qrcode": "^1.5.4",
    "resend": "6.28.0",
    "sharp": "^0.35.4",
    "tsx": "4.20.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.3",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.1.12",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
