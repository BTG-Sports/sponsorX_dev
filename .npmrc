# npm's arborist crashes with "Cannot read properties of null (reading
# 'edgesOut')" while resolving the peer-dependency set for this workspace
# graph (npm 10.x, plain `npm install`). legacy-peer-deps sidesteps the buggy
# deep peer walk and installs cleanly. It also keeps `npm ci` in the Docker
# builds consistent with local installs. Revisit when npm fixes the arborist
# bug and drop this line.
legacy-peer-deps=true
