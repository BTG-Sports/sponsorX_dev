%% Page 9 of 11 — Stage 8. Tracking and the fan reward. §16 QR workflow.
    IN[/"FROM PAGE 8 · deliverable PUBLISHED"/]:::conn
    H1["Unique tracking link and QR minted per athlete"]:::system
    H2["Athlete shares the link or QR"]:::athlete
    H3["Fan scans the QR or follows the link"]:::fan
    EV1["RewardEvent · SCAN"]:::state
    H4["Fan lands on the public reward page, no login"]:::fan
    EV2["RewardEvent · LANDING"]:::state
    CLAIM{"Fan claims<br/>the offer?"}
    ENDF(["END · scan recorded, nothing claimed"]):::term
    H5["Fan consents and gives an email"]:::fan
    EV3["RewardEvent · CLAIM"]:::state
    H6["Coupon or token issued"]:::system
    RED{"Redeemed at<br/>the venue?"}
    EV4["RewardEvent · REDEEM"]:::state
    OUT[/"CONTINUES ON PAGE 10"/]:::conn

    IN --> H1 --> H2 --> H3 --> EV1 --> H4 --> EV2 --> CLAIM
    CLAIM -- "no" --> ENDF
    CLAIM -- "yes" --> H5 --> EV3 --> H6 --> RED
    RED -- "no" --> ENDF
    RED -- "yes" --> EV4 --> OUT
