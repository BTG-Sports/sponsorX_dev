    ST0["OrderState · COMPLETED"]:::state
    ST1["EarningState · PENDING → ELIGIBLE"]:::state
    J4["Finance reviews the earning"]:::btg
    Q{"Query or<br/>dispute?"}
    ST2["EarningState · HELD or DISPUTED"]:::state
    J5["Resolved by finance"]:::btg
    ST3["EarningState · APPROVED_FOR_PAYOUT"]:::state
    J6["Payment made OUTSIDE SponsorX"]:::btg
    ST4["EarningState · PAID"]:::state
    OUT[/"CONTINUES ON PAGE 11"/]:::conn

    IN --> J1 --> J2 --> J3 --> ALL
    ALL -- "no" --> WAIT
    ALL -- "yes" --> ST0 --> ST1 --> J4 --> Q
    Q -- "yes" --> ST2 --> J5 --> ST1
    Q -- "no" --> ST3 --> J6 --> ST4 --> OUT
