%% Page 7 of 11 — Stage 6. Campaign Order. §12 agreements, §13 steps 6-7, §21 OrderState.
    IN[/"FROM PAGE 6 · invitation ACCEPTED"/]:::conn
    F1["Order drafted: job, compensation,<br/>usage rights, exclusivity, deadline"]:::system
    ST1["OrderState · DRAFT"]:::state
    F2["Campaign Manager sends the order"]:::btg
    ST2["OrderState · SENT"]:::state
    F3["Athlete reads the terms"]:::athlete
    ACC{"Accepts?"}
    ST3["OrderState · REJECTED"]:::state
    ENDR(["END for this athlete · re-staff on page 6"]):::term
    MINOR{"Minor?"}
    F4["Guardian co-signs"]:::athlete
    F5["AgreementAcceptance written with body hash"]:::system
    ST4["OrderState · ACCEPTED"]:::state
    F6["Deliverables and due dates created"]:::system
    ST5["OrderState · ACTIVE"]:::state
    OUT[/"CONTINUES ON PAGE 8"/]:::conn

    IN --> F1 --> ST1 --> F2 --> ST2 --> F3 --> ACC
    ACC -- "rejects" --> ST3 --> ENDR
    ACC -- "accepts" --> MINOR
    MINOR -- "yes" --> F4 --> F5
    MINOR -- "no" --> F5
    F5 --> ST4 --> F6 --> ST5 --> OUT
