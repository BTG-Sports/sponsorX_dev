{"nodes": [{"id": "graphify_out_converted_my_view_be097e72_document", "label": "My View - Founder Strategy Note (Athlete Network Program, 90-Day Launch)", "file_type": "document", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_my_view_be097e72_athlete_network_program", "label": "BTG SponsorX Athlete Network Program (Managed Micro-NIL Launch)", "file_type": "concept", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Launch as a managed micro-NIL network while the technology is being built: 4 anchor athletes grow to 25 without requiring every athlete to become a full BTG representation client; DMV athletes recruited first for local-business geographic relevance."}, {"id": "graphify_out_converted_my_view_be097e72_content_value_score", "label": "SponsorX Content Value Score (100-Point Qualification)", "file_type": "concept", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids making SponsorX a follower-count competition; a 2,500-follower athlete with great video and conversions can outrank a 20,000-follower passive one."}, {"id": "graphify_out_converted_my_view_be097e72_sponsorx_test_drive", "label": "SponsorX Test Drive Package ($750 Entry Product)", "file_type": "concept", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$750 is a much easier first conversation than $5,000 for a business that has never bought NIL marketing; campaign results then power the upsell to 10-athlete and community packages."}, {"id": "graphify_out_converted_my_view_be097e72_early_flywheel", "label": "SponsorX Early Flywheel (Athletes > Inventory > Sponsors > Data > Matching)", "file_type": "rationale", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More athletes create more inventory, sponsors, campaigns and athlete income, which recruits more athletes and produces campaign data that improves matching and sponsor performance - letting SponsorX grow larger than BTG's own social following."}, {"id": "graphify_out_converted_my_view_be097e72_per_athlete_tracking", "label": "Per-Athlete Tracking Codes (Individual QR/URL per Athlete)", "file_type": "concept", "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One generic campaign link hides which athlete performs commercially; unique codes reveal that follower count is not the deciding factor and feed athlete performance learning."}], "edges": [{"source": "graphify_out_converted_my_view_be097e72_document", "target": "graphify_out_converted_my_view_be097e72_athlete_network_program", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_my_view_be097e72_document", "target": "graphify_out_converted_my_view_be097e72_content_value_score", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/My View_be097e72.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_my_view_be097e72_document", "target": "graphify_out_converted_my_view_be097e72_sponsorx_test_drive", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/My View_be