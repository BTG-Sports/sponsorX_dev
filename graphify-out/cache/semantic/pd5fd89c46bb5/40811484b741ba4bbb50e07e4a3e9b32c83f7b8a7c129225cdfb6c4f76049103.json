{"nodes": [{"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "label": "BTG SponsorX Systems Architecture (Draft 0.1, Phase 1)", "file_type": "document", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_modular_monolith", "label": "Modular Monolith Backend (Node.js + Express, Domain Modules)", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over microservices as the fastest path to a working loop for a small team; each domain is a self-contained feature folder (router + service + repository) owning its tables, so later extraction into services stays cheap."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_pooled_multi_tenancy", "label": "Pooled Multi-Tenancy (Shared DB, Mandatory tenant_id)", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest-friction model for a small operator; a central access layer injects the caller's tenant into every query so application code cannot accidentally read across tenants; Postgres RLS available as defense in depth."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_typescript_stack", "label": "Confirmed TypeScript Stack (Next.js / Express / Prisma / PostgreSQL / Redis / MinIO)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single language across frontend and backend keeps a small team fast and lets both share types; MinIO speaks the S3 API so storage code works unchanged if buckets later move to AWS S3 or Cloudflare R2."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_metric_provenance", "label": "Metric Provenance as First-Class Field", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every metric row records a data-quality label so dashboards never present self-reported numbers as verified - a core data-integrity requirement protecting credibility given Phase 1's largely manual metrics."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_transactional_outbox", "label": "Transactional Outbox + Idempotent Integration Pattern", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain writes and to-be-synced events commit in the same transaction, a worker drains the outbox with idempotency keys, backoff and dead-letter - preventing Zoho/SponsorX drift and double-writes."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_campaign_operating_loop", "label": "Campaign Operating Loop (Architecture Sequence)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_app_shell_role_routing", "label": "One App Shell, Three Role-Aware Portals", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The portals share auth, layout, tables and charts; a single shell with role-aware routing avoids triplicating that surface while giving each role a distinct navigation, theme accent and permitted feature set."}, {"id": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_phase_forward_compatibility", "label": "Phase-Forward Compatibility Seams", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing in Phase 1 should be redesigned to admit later phases: packages/inventory/orders already model priced inventory for Phase 2, metric events and scores create clean history for Phase 3, and inventory/reward/metric models are shaped to accept INFINEX placements in Phase 4."}], "edges": [{"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_modular_monolith", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_pooled_multi_tenancy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_typescript_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_metric_provenance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_transactional_outbox", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_campaign_operating_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_app_shell_role_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/BTG_SponsorX_Systems_Architecture_d593563b.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_document", "target": "graphify_out_converted_btg_sponsorx_systems_architecture_d593563b_phase_forward_com