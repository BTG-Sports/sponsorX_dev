{"nodes": [{"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_document", "label": "BTG SponsorX Master Development Blueprint v2.0 - Integrated Athlete Network (Sep 2026)", "file_type": "document", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_managed_micro_nil_marketplace", "label": "Managed Micro-NIL Athlete Network / Marketplace (Phase 1 Strategy)", "file_type": "rationale", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v2.0 changes launch strategy: instead of waiting for BTG to build a large owned audience, organize many smaller athlete audiences into sponsor-ready campaigns; BTG staff controls matching, pricing, conflict checks and invoicing while software records every step."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_core_operating_loop", "label": "Core Operating Loop v2 (Sponsor Brief to Renewal)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SPONSOR > CAMPAIGN BRIEF > MATCHING > ATHLETE OPT-IN > CAMPAIGN ORDER > CONTENT > TRACKING/REWARD > EARNINGS > SPONSOR REPORT > RENEWAL; sponsor-driven rather than property-inventory-driven."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_anchor_athlete", "label": "BTG Anchor Athlete", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_sponsorx_content_partner", "label": "SponsorX Content Partner (Non-Exclusive Athlete)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Athletes join under a limited non-exclusive Content Collaboration Agreement without full representation - the key to scaling the network quickly."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_nil_job_catalog", "label": "Standard NIL Job Catalog SX-01..SX-07", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardized jobs (Story Drop through Monthly Ambassador) with base athlete pay and sponsor sell price so BTG never negotiates every small activation from scratch."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_sponsor_package_catalog", "label": "Sponsor Package Catalog (Test Drive to Season Partner)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$750 Test Drive exists as a deliberately low-friction first purchase; packages scale to $15K-$30K+ Season Partner category ownership."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_content_value_score", "label": "Athlete Content Value Score", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follower count is deliberately not the primary ranking method; weighted factors (engagement 25%, content quality 20%, audience 15%, reliability 15%, geography 10%, fit 10%, sponsor performance 5%) are rules/manual in Phase 1 and become versioned algorithmic scoring in Phase 3."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_campaign_order", "label": "Campaign Order Workflow (Blueprint v2)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System stores agreement metadata and signature references rather than hard-coding legal terms; records agreement version, acceptance timestamp, signer, and guardian authorization."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_integrated_athlete_network_f5776aa7_phase1_state_machines", "label": "Phase 1 State Machines (Application/Brief/Order/Deliverable/Campaign/Earnings/Reward)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_Integrated_Athlete_Network_f5776aa7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_i