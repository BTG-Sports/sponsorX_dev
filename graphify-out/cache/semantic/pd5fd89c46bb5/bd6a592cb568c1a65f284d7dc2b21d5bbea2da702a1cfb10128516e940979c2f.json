{"nodes": [{"id": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_document", "label": "A2 State & Polish + Portal Wow \u2014 Design Spec", "file_type": "document", "rationale": "Approved user decisions: combined A2 pass extended with sponsor-grade stats for admin/athlete/property/public; Frost light theme via data-theme toggle; branded states; differentiated per-portal heroes; foundation-first sequencing. \u00a72 tables give every hero stat a fixture value and a Block B retrieval path.", "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_frost_light_theme", "label": "Frost Light Theme", "file_type": "concept", "rationale": "[data-theme=light] re-points the same --sx-* custom properties (dark stays :root default) so both themes cascade through Tailwind's @theme inline mapping with no class changes; brand hues darkened one step for AA contrast; sun/moon toggle + localStorage + pre-paint inline script; redeem page stays dark (no-JS rule).", "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_branded_state_system", "label": "Branded State System (states.tsx)", "file_type": "concept", "rationale": "Accent-shimmer skeletons mirroring real layouts, EmptyState with SVG mark + next-action link, ErrorPanel with reference code + retry; loading.tsx per route, error.tsx per group, branded 404; prefers-reduced-motion safe.", "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_demo_switcher", "label": "?demo= State Switcher", "file_type": "concept", "rationale": "Pages read ?demo=loading|empty|error server-side via demoState(searchParams) and render that state live \u2014 demoable to the client and real wiring for Block B; production behavior unaffected when the param is absent.", "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_differentiated_heroes", "label": "Differentiated Portal Heroes", "file_type": "concept", "rationale": "Each audience gets its own hero moment on shared components: admin operations board (Network GMV $1,284,500, queue tickers), athlete personal milestone ($46,250 career earnings, payout ring), property audience showcase (2.4\u20132.5M est. views), public landing networkStats count-up \u2014 every stat with a named Block B retrieval path.", "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_document", "target": "docs_superpowers_specs_2026_09_11_sponsor_portal_redesign_design_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_09_11_a2_state_polish_portal_wow_design_document", "target": "memory_2026_09_11_tasks_completed_stats_must_be_retrievable", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-09-11-a2-state-polish-portal-wow-design.md", "so