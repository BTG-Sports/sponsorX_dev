{"nodes": [{"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_document", "label": "BTG SponsorX Master Development Blueprint v1.0 (Aug 2026)", "file_type": "document", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_core_operating_loop", "label": "Core Operating Loop v1 (Property to Renewal)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PROPERTY > INVENTORY > SPONSOR > CAMPAIGN > CONTENT/ACTIVATION > FAN ACTION > REWARD/REDEMPTION > ANALYTICS > RENEWAL; assumes BTG-owned property inventory drives launch."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_cpm_pricing_algorithm", "label": "CPM & Pricing Algorithm (Multiplier Formula)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended CPM = Base CPM x Engagement x Audience Quality x Geo x Format x Exclusivity x Demand x Performance Confidence; each component stored so the recommendation is explainable, with authorized override logged."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_qr_reward_engine", "label": "QR Reward & Fan Commerce Engine", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scan, visit, claim and redemption stored as separate events to preserve funnel analytics; a QR scan is never equated with a redemption or purchase."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_zoho_crm_integration", "label": "Zoho CRM Integration (v1 Spec)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SponsorX is system-of-record for inventory/campaign delivery, Zoho for sales relationship; event queue with retries and external IDs so Zoho outages never break campaign operations."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_twelve_core_screens", "label": "12 Core Screen Product Specification", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_rbac_tenant_scoping", "label": "RBAC + Tenant Scoping Permission Model", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every protected record includes tenant_id; sensitive actions require explicit permissions rather than role names alone; all administrative mutations write an audit_log record."}, {"id": "graphify_out_converted_btg_sponsorx_master_development_blueprint_609a437c_data_quality_flags", "label": "Data Quality Flags (VERIFIED_API / VERIFIED_MANUAL / SELF_REPORTED / ESTIMATED / ATTRIBUTED)", "file_type": "concept", "source_file": "graphify-out/converted/BTG_SponsorX_Master_Development_Blueprint_609a437c.md", "source_location": null, "source_url": 